// ===== BEGIN INLINE MODULE: Modules/SessionsNewsPanel.mqh =====
// SESSIONS & NEWS PANEL
// Displays global trading sessions and the existing MQL5 economic-calendar cache.

input group "=== Sessions & News Panel ==="
input int  InpSN_X = 410;                 // Panel X position
input int  InpSN_Y = 25;                  // Panel Y position
input bool InpSN_ShowHeadlines = true;    // Show GDELT headlines section

#define SN_PREFIX "CM_SN_"
#define SN_WIDTH 365
#define SN_HEIGHT 510
#define SN_NEWS_ROWS 4
#define SN_HEADLINE_ROWS 2

//--- UI helpers
void SN_Rect(string id,int x,int y,int w,int h,color bg,color border)
{
   string n=SN_PREFIX+id;
   if(ObjectFind(0,n)<0 && !ObjectCreate(0,n,OBJ_RECTANGLE_LABEL,0,0,0))
   {
      Print("Sessions & News: cannot create ",n,". Error: ",GetLastError());
      return;
   }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,n,OBJPROP_XSIZE,w);
   ObjectSetInteger(0,n,OBJPROP_YSIZE,h);
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg);
   ObjectSetInteger(0,n,OBJPROP_COLOR,border);
   ObjectSetInteger(0,n,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
   ObjectSetInteger(0,n,OBJPROP_ZORDER,2);
}

void SN_Label(string id,int x,int y,string value,color clr,int size=8,
              string font="Tahoma",ENUM_ANCHOR_POINT anchor=ANCHOR_LEFT_UPPER)
{
   string n=SN_PREFIX+id;
   if(ObjectFind(0,n)<0 && !ObjectCreate(0,n,OBJ_LABEL,0,0,0))
   {
      Print("Sessions & News: cannot create ",n,". Error: ",GetLastError());
      return;
   }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_ANCHOR,anchor);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetString(0,n,OBJPROP_TEXT,value);
   ObjectSetString(0,n,OBJPROP_FONT,font);
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,size);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
   ObjectSetInteger(0,n,OBJPROP_ZORDER,3);
}

void SN_SetLabel(string id,string value,color clr)
{
   string n=SN_PREFIX+id;
   if(ObjectFind(0,n)<0) return;
   ObjectSetString(0,n,OBJPROP_TEXT,value);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
}

void SN_Button(string id,int x,int y,int w,int h,string value)
{
   string n=SN_PREFIX+id;
   if(ObjectFind(0,n)<0 && !ObjectCreate(0,n,OBJ_BUTTON,0,0,0))
   {
      Print("Sessions & News: cannot create button ",n,". Error: ",GetLastError());
      return;
   }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,n,OBJPROP_XSIZE,w);
   ObjectSetInteger(0,n,OBJPROP_YSIZE,h);
   ObjectSetString(0,n,OBJPROP_TEXT,value);
   ObjectSetString(0,n,OBJPROP_FONT,"Tahoma");
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,8);
   ObjectSetInteger(0,n,OBJPROP_COLOR,C_TEXT);
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,C_BTN);
   ObjectSetInteger(0,n,OBJPROP_BORDER_COLOR,C_BORDER);
   ObjectSetInteger(0,n,OBJPROP_STATE,false);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,n,OBJPROP_ZORDER,5);
}

//--- UTC calendar helpers for daylight-saving transitions
datetime SN_MakeUTC(int year,int month,int day,int hour,int minute=0)
{
   MqlDateTime p;
   p.year=year; p.mon=month; p.day=day;
   p.hour=hour; p.min=minute; p.sec=0;
   return StructToTime(p);
}

int SN_Weekday(int year,int month,int day)
{
   MqlDateTime p;
   datetime d=SN_MakeUTC(year,month,day,12,0);
   if(!TimeToStruct(d,p)) return -1;
   return p.day_of_week; // Sunday = 0
}

int SN_FirstSunday(int year,int month)
{
   for(int day=1;day<=7;day++)
      if(SN_Weekday(year,month,day)==0) return day;
   return 1;
}

int SN_NthSunday(int year,int month,int nth)
{
   return SN_FirstSunday(year,month)+(nth-1)*7;
}

int SN_DaysInMonth(int year,int month)
{
   if(month==2)
      return ((year%4==0 && year%100!=0) || year%400==0) ? 29 : 28;
   if(month==4 || month==6 || month==9 || month==11) return 30;
   return 31;
}

int SN_LastSunday(int year,int month)
{
   for(int day=SN_DaysInMonth(year,month);day>=SN_DaysInMonth(year,month)-6;day--)
      if(SN_Weekday(year,month,day)==0) return day;
   return SN_DaysInMonth(year,month)-6;
}

bool SN_IsLondonDST(datetime utc_now)
{
   MqlDateTime p;
   if(!TimeToStruct(utc_now,p)) return false;
   datetime start=SN_MakeUTC(p.year,3,SN_LastSunday(p.year,3),1);
   datetime finish=SN_MakeUTC(p.year,10,SN_LastSunday(p.year,10),1);
   return (utc_now>=start && utc_now<finish);
}

bool SN_IsNewYorkDST(datetime utc_now)
{
   MqlDateTime p;
   if(!TimeToStruct(utc_now,p)) return false;
   datetime start=SN_MakeUTC(p.year,3,SN_NthSunday(p.year,3,2),7);
   datetime finish=SN_MakeUTC(p.year,11,SN_FirstSunday(p.year,11),6);
   return (utc_now>=start && utc_now<finish);
}

bool SN_IsSydneyDST(datetime utc_now)
{
   MqlDateTime p;
   if(!TimeToStruct(utc_now,p)) return false;
   datetime start=SN_MakeUTC(p.year,10,SN_FirstSunday(p.year,10),0)-8*3600;
   datetime finish=SN_MakeUTC(p.year,4,SN_FirstSunday(p.year,4),0)-8*3600;
   return (utc_now>=start || utc_now<finish);
}

string SN_FormatDuration(int seconds)
{
   if(seconds<0) seconds=0;
   int h=seconds/3600;
   int m=(seconds%3600)/60;
   int s=seconds%60;
   if(h>0) return StringFormat("%02d:%02d:%02d",h,m,s);
   return StringFormat("%02d:%02d",m,s);
}

string SN_SessionStatus(datetime utc_now,int start_hour,int end_hour)
{
   MqlDateTime p;
   if(!TimeToStruct(utc_now,p)) return "زمان نامشخص";
   int now_seconds=p.hour*3600+p.min*60+p.sec;
   int start_seconds=start_hour*3600;
   int end_seconds=end_hour*3600;
   bool open=false;
   if(start_seconds<end_seconds)
      open=(now_seconds>=start_seconds && now_seconds<end_seconds);
   else
      open=(now_seconds>=start_seconds || now_seconds<end_seconds);

   int remaining=0;
   if(open)
      remaining=(end_seconds-now_seconds+86400)%86400;
   else
      remaining=(start_seconds-now_seconds+86400)%86400;

   if(!open && remaining==0) remaining=86400;
   if(open)
      return "فعال  |  پایان "+SN_FormatDuration(remaining);
   return "غیرفعال  |  شروع "+SN_FormatDuration(remaining);
}

string SN_TranslateNewsTitle(string source_title)
{
   string s=source_title;
   string lower=s;
   StringToLower(lower);

   if(StringFind(lower,"nonfarm payroll")>=0 || StringFind(lower,"non-farm payroll")>=0 ||
      StringFind(lower,"nonfarm employment")>=0) return "اشتغال بخش غیرکشاورزی آمریکا (NFP)";
   if(StringFind(lower,"core cpi")>=0) return "شاخص قیمت مصرف‌کننده هسته‌ای";
   if(StringFind(lower,"cpi")>=0 || StringFind(lower,"consumer price index")>=0)
      return "شاخص قیمت مصرف‌کننده";
   if(StringFind(lower,"core pce")>=0) return "شاخص هسته‌ای مخارج مصرف شخصی (PCE)";
   if(StringFind(lower,"pce price")>=0) return "شاخص مخارج مصرف شخصی (PCE)";
   if(StringFind(lower,"ppi")>=0 || StringFind(lower,"producer price index")>=0)
      return "شاخص قیمت تولیدکننده";
   if(StringFind(lower,"unemployment rate")>=0) return "نرخ بیکاری";
   if(StringFind(lower,"initial jobless claims")>=0 || StringFind(lower,"unemployment claims")>=0)
      return "درخواست اولیه بیمه بیکاری";
   if(StringFind(lower,"retail sales")>=0) return "فروش خرده‌فروشی";
   if(StringFind(lower,"gross domestic product")>=0 || StringFind(lower,"gdp")>=0)
      return "تولید ناخالص داخلی (GDP)";
   if(StringFind(lower,"interest rate decision")>=0 || StringFind(lower,"rate decision")>=0 ||
      StringFind(lower,"federal funds rate")>=0) return "تصمیم نرخ بهره";
   if(StringFind(lower,"fomc press conference")>=0) return "نشست خبری کمیته بازار آزاد فدرال";
   if(StringFind(lower,"fomc minutes")>=0) return "صورت‌جلسه کمیته بازار آزاد فدرال";
   if(StringFind(lower,"fomc statement")>=0) return "بیانیه کمیته بازار آزاد فدرال";
   if(StringFind(lower,"manufacturing pmi")>=0) return "شاخص مدیران خرید بخش تولید";
   if(StringFind(lower,"services pmi")>=0) return "شاخص مدیران خرید بخش خدمات";
   if(StringFind(lower,"pmi")>=0 || StringFind(lower,"purchasing managers")>=0)
      return "شاخص مدیران خرید (PMI)";
   if(StringFind(lower,"consumer confidence")>=0) return "اعتماد مصرف‌کننده";
   if(StringFind(lower,"trade balance")>=0) return "تراز تجاری";
   if(StringFind(lower,"housing starts")>=0) return "آغاز ساخت‌وساز مسکن";
   if(StringFind(lower,"durable goods")>=0) return "سفارش کالاهای بادوام";
   if(StringFind(lower,"industrial production")>=0) return "تولید صنعتی";
   if(StringFind(lower,"retail sales")>=0) return "فروش خرده‌فروشی";
   if(StringFind(lower,"central bank")>=0 && StringFind(lower,"speech")>=0)
      return "سخنرانی مقام بانک مرکزی";
   return source_title; // Unknown names stay in English rather than being mistranslated.
}

string SN_ImportancePersian(int importance)
{
   if(importance==(int)CALENDAR_IMPORTANCE_HIGH) return "زیاد";
   if(importance==(int)CALENDAR_IMPORTANCE_MODERATE) return "متوسط";
   if(importance==(int)CALENDAR_IMPORTANCE_LOW) return "کم";
   return "نامشخص";
}

string SN_FormatCalendarValue(bool available,double value,int digits)
{
   if(!available) return "-";
   int precision=MathMax(0,MathMin(8,digits));
   return DoubleToString(value,precision);
}

void SN_CreatePanel()
{
   int x=InpSN_X, y=InpSN_Y, pad=13;
   SN_Rect("bg",x,y,SN_WIDTH,SN_HEIGHT,C_BG,C_BORDER);
   SN_Rect("header",x,y,SN_WIDTH,42,C_HEADER,C_HEADER);
   SN_Rect("line",x,y+42,SN_WIDTH,2,C_ACCENT,C_ACCENT);
   SN_Label("title",x+pad,y+11,"سشن‌ها و اخبار اقتصادی",C_TEXT,11,"Tahoma");
   SN_Button("btn_news_refresh",x+SN_WIDTH-91,y+9,78,24,"تازه‌سازی خبر");

   SN_Label("sessions_title",x+pad,y+55,"وضعیت سشن‌های معاملاتی",C_ACCENT,9,"Tahoma");
   SN_Rect("candle_chip",x+SN_WIDTH-160,y+50,147,24,C_CARD,C_BORDER);
   SN_Label("candle_timer",x+SN_WIDTH-154,y+55,"کندل: در حال محاسبه...",C_ACCENT,8,"Tahoma");
   string session_names[4]={"سیدنی","توکیو","لندن","نیویورک"};
   for(int i=0;i<4;i++)
   {
      int row_y=y+79+i*22;
      SN_Label("session_name_"+IntegerToString(i),x+pad,row_y,session_names[i],C_TEXT,9,"Tahoma");
      SN_Label("session_state_"+IntegerToString(i),x+108,row_y,"در حال محاسبه...",C_MUTED,8,"Tahoma");
   }

   SN_Rect("divider",x+pad,y+169,SN_WIDTH-2*pad,1,C_BORDER,C_BORDER);
   SN_Label("calendar_title",x+pad,y+180,"تقویم اقتصادی",C_ACCENT,9,"Tahoma");
   SN_Button("btn_headline_refresh",x+SN_WIDTH-91,y+175,78,23,"تیترهای جدید");
   SN_Label("calendar_status",x+pad,y+202,"در حال دریافت اطلاعات تقویم...",C_MUTED,8,"Tahoma");
   SN_Rect("news_card",x+pad-4,y+222,SN_WIDTH-2*pad+8,184,C_CARD,C_BORDER);
   for(int i=0;i<SN_NEWS_ROWS;i++)
   {
      int row_y=y+229+i*42;
      SN_Label("news_meta_"+IntegerToString(i),x+pad+4,row_y,"-",C_WARN,8,"Tahoma");
      SN_Label("news_title_"+IntegerToString(i),x+pad+4,row_y+14,"-",C_TEXT,9,"Tahoma");
      SN_Label("news_values_"+IntegerToString(i),x+pad+4,row_y+27,"-",C_MUTED,7,"Tahoma");
      if(i<SN_NEWS_ROWS-1)
         SN_Rect("news_sep_"+IntegerToString(i),x+pad+4,row_y+40,SN_WIDTH-2*pad-8,1,C_BORDER,C_BORDER);
   }

   if(InpSN_ShowHeadlines)
   {
      SN_Label("headlines_title",x+pad,y+414,"تیترهای جهانی",C_ACCENT,9,"Tahoma");
      SN_Label("headlines_status",x+pad,y+434,"در حال دریافت تیترها...",C_MUTED,7,"Tahoma");
      for(int i=0;i<SN_HEADLINE_ROWS;i++)
      {
         int row_y=y+453+i*23;
         SN_Label("headline_title_"+IntegerToString(i),x+pad+4,row_y,"-",C_TEXT,8,"Tahoma");
         SN_Label("headline_meta_"+IntegerToString(i),x+pad+4,row_y+13,"-",C_MUTED,7,"Tahoma");
      }
   }
}

void SN_UpdatePanel()
{
   datetime utc_now=TimeGMT();
   if(utc_now<=0) utc_now=TimeCurrent();

   bool sydney_dst=SN_IsSydneyDST(utc_now);
   bool london_dst=SN_IsLondonDST(utc_now);
   bool newyork_dst=SN_IsNewYorkDST(utc_now);

   string state=SN_SessionStatus(utc_now,sydney_dst?21:22,sydney_dst?6:7);
   SN_SetLabel("session_state_0",state,StringFind(state,"فعال")==0? C_ACCENT:C_MUTED);
   state=SN_SessionStatus(utc_now,0,9);
   SN_SetLabel("session_state_1",state,StringFind(state,"فعال")==0? C_ACCENT:C_MUTED);
   state=SN_SessionStatus(utc_now,london_dst?7:8,london_dst?16:17);
   SN_SetLabel("session_state_2",state,StringFind(state,"فعال")==0? C_ACCENT:C_MUTED);
   state=SN_SessionStatus(utc_now,newyork_dst?12:13,newyork_dst?21:22);
   SN_SetLabel("session_state_3",state,StringFind(state,"فعال")==0? C_ACCENT:C_MUTED);

   string calendar_status;
   if(!gNewsDataOK) calendar_status="تقویم اقتصادی در دسترس نیست؛ اتصال و پشتیبانی بروکر را بررسی کن";
   else if(gNewsCount<=0) calendar_status="رویدادی برای نمایش در این نماد ثبت نشده";
   else calendar_status=IntegerToString(gNewsCount)+" رویداد | زمان انتشار بر اساس سرور بروکر";
   if(gNewsBlock) calendar_status+=" | فیلتر خبری: مسدود";
   SN_SetLabel("calendar_status",calendar_status,gNewsBlock? C_SELL:(gNewsDataOK? C_MUTED:C_WARN));

   for(int i=0;i<SN_NEWS_ROWS;i++)
   {
      string meta="-";
      string title=(i==0 && !gNewsDataOK)? "داده تقویم اقتصادی دریافت نشد":"رویدادی ثبت نشده";
      string values="-";
      color clr=C_MUTED;
      if(i<gNewsCount)
      {
         meta=gNews[i].currency+" | اهمیت "+SN_ImportancePersian(gNews[i].importance)+
              " | "+TimeToString(gNews[i].time,TIME_DATE|TIME_MINUTES);
         title=SN_TranslateNewsTitle(gNews[i].title);
         if(StringLen(title)>48) title=StringSubstr(title,0,45)+"...";
         values="واقعی: "+SN_FormatCalendarValue(gNews[i].hasActual,gNews[i].actual,gNews[i].digits)+
                "  پیش‌بینی: "+SN_FormatCalendarValue(gNews[i].hasForecast,gNews[i].forecast,gNews[i].digits)+
                "  قبلی: "+SN_FormatCalendarValue(gNews[i].hasPrevious,gNews[i].previous,gNews[i].digits);
         clr=NewsImportanceColor(gNews[i].importance);
      }
      SN_SetLabel("news_meta_"+IntegerToString(i),meta,clr);
      SN_SetLabel("news_title_"+IntegerToString(i),title,i<gNewsCount? C_TEXT:C_MUTED);
      SN_SetLabel("news_values_"+IntegerToString(i),values,i<gNewsCount? C_MUTED:C_MUTED);
   }

   if(InpSN_ShowHeadlines)
   {
      string hs=!gHeadlineDataOK? "تیترهای زنده در دسترس نیستند":
                (gHeadlineCount>0? IntegerToString(gHeadlineCount)+" تیتر | ۲۴ ساعت اخیر":"تیتر مرتبطی پیدا نشد");
      SN_SetLabel("headlines_status",hs,gHeadlineDataOK? C_MUTED:C_WARN);
      for(int i=0;i<SN_HEADLINE_ROWS;i++)
      {
         string title=i<gHeadlineCount? gHeadlines[i].title:"تیتر خبری موجود نیست";
         string meta=i<gHeadlineCount? gHeadlines[i].source:"-";
         if(StringLen(title)>47) title=StringSubstr(title,0,44)+"...";
         if(StringLen(meta)>54) meta=StringSubstr(meta,0,51)+"...";
         SN_SetLabel("headline_title_"+IntegerToString(i),title,i<gHeadlineCount? C_TEXT:C_MUTED);
         SN_SetLabel("headline_meta_"+IntegerToString(i),meta,C_MUTED);
      }
   }
}

bool SN_Init()
{
   SN_CreatePanel();
   SN_UpdatePanel();
   return true;
}

void SN_Deinit()
{
   ObjectsDeleteAll(0,SN_PREFIX);
   ChartRedraw(0);
}

void SN_ChartEvent(const int id,const long &lparam,const double &dparam,const string &sparam)
{
   if(id!=CHARTEVENT_OBJECT_CLICK) return;
   if(sparam==SN_PREFIX+"btn_news_refresh")
   {
      ObjectSetInteger(0,sparam,OBJPROP_STATE,false);
      RefreshNews();
      SN_UpdatePanel();
   }
   else if(sparam==SN_PREFIX+"btn_headline_refresh")
   {
      ObjectSetInteger(0,sparam,OBJPROP_STATE,false);
      RefreshHeadlines(true);
      SN_UpdatePanel();
   }
}

// ===== END INLINE MODULE: Modules/SessionsNewsPanel.mqh =====


// ===== BEGIN INLINE MODULE: Modules/CandleCloseCountdown.mqh =====
// CANDLE CLOSE COUNTDOWN MODULE
// Reuses the Expert Advisor's centralized timer and chart-event dispatcher.
//+------------------------------------------------------------------+
//| CandleCloseCountdown.mq5                                         |
//| ChartMasters - Candle close countdown for MetaTrader 5          |
//+------------------------------------------------------------------+

input group "Candle countdown"
input int InpCCT_MaxTickAgeSeconds = 300; // Suppress countdown when quote data is stale

// Broker-time clock anchored to the latest quote, then advanced locally.
// This keeps the countdown in the same time base as the chart candles.
string          g_cct_clock_symbol = "";
datetime        g_cct_clock_base_server_time = 0;
uint            g_cct_clock_base_local_ms = 0;
long            g_cct_last_tick_time_msc = 0;

//+------------------------------------------------------------------+
//| Convert seconds to MM:SS or HH:MM:SS                             |
//+------------------------------------------------------------------+
string CCT_FormatCountdown(const long total_seconds)
{
   long seconds = total_seconds;
   if(seconds < 0)
      seconds = 0;

   int hours   = (int)(seconds / 3600);
   int minutes = (int)((seconds % 3600) / 60);
   int secs    = (int)(seconds % 60);

   if(hours > 0)
      return StringFormat("%02d:%02d:%02d", hours, minutes, secs);

   return StringFormat("%02d:%02d", minutes, secs);
}

//+------------------------------------------------------------------+
//| Human-readable timeframe label                                   |
//+------------------------------------------------------------------+
string CCT_TimeframeLabel(const ENUM_TIMEFRAMES timeframe)
{
   string label = EnumToString(timeframe);
   StringReplace(label, "PERIOD_", "");
   return label;
}

//+------------------------------------------------------------------+
//| Calculate the close time of the current bar                      |
//+------------------------------------------------------------------+
datetime CCT_CurrentBarCloseTime(const ENUM_TIMEFRAMES timeframe,
                             const datetime bar_open)
{
   // A calendar month is not always 30 days. Calculate MN1 exactly.
   if(timeframe == PERIOD_MN1)
   {
      MqlDateTime parts;
      if(!TimeToStruct(bar_open, parts))
         return 0;

      parts.day  = 1;
      parts.hour = 0;
      parts.min  = 0;
      parts.sec  = 0;
      parts.mon++;
      if(parts.mon > 12)
      {
         parts.mon = 1;
         parts.year++;
      }
      return StructToTime(parts);
   }

   int seconds = PeriodSeconds(timeframe);
   if(seconds <= 0)
      return 0;

   return bar_open + seconds;
}

//+------------------------------------------------------------------+
//| Check whether current time is inside a quote session             |
//| has_schedule=false means broker supplied no schedule for the     |
//| checked days; live-tick freshness is then used as a fallback.    |
//+------------------------------------------------------------------+
bool CCT_IsInsideQuoteSession(const string symbol,
                          const datetime now,
                          bool &has_schedule)
{
   has_schedule = false;

   MqlDateTime now_parts;
   if(!TimeToStruct(now, now_parts))
      return false;

   int seconds_today = now_parts.hour * 3600 + now_parts.min * 60 + now_parts.sec;
   datetime today_midnight = now - seconds_today;

   // Check today's sessions and yesterday's sessions to support
   // sessions that continue past midnight.
   for(int day_offset = 0; day_offset >= -1; day_offset--)
   {
      datetime session_day = today_midnight + (day_offset * 86400);
      MqlDateTime session_day_parts;
      if(!TimeToStruct(session_day, session_day_parts))
         continue;

      ENUM_DAY_OF_WEEK day = (ENUM_DAY_OF_WEEK)session_day_parts.day_of_week;

      for(uint session_index = 0; session_index < 32; session_index++)
      {
         datetime session_from = 0;
         datetime session_to   = 0;

         if(!SymbolInfoSessionQuote(symbol, day, session_index, session_from, session_to))
            break;

         has_schedule = true;

         datetime session_start = session_day + (long)session_from;
         datetime session_end   = session_day + (long)session_to;

         // Some brokers describe an overnight session with an end
         // time earlier than its start time.
         if(session_end <= session_start)
            session_end += 86400;

         if(now >= session_start && now < session_end)
            return true;
      }
   }

   return false;
}

//+------------------------------------------------------------------+
//| Estimate broker time from the latest quote                       |
//| The local millisecond counter advances between incoming ticks.   |
//+------------------------------------------------------------------+
bool CCT_GetBrokerClock(const string symbol,
                    datetime &server_now,
                    datetime &last_quote_time)
{
   server_now = 0;
   last_quote_time = 0;

   MqlTick tick;
   if(!SymbolInfoTick(symbol, tick))
      return false;

   datetime tick_time = tick.time;
   if(tick_time <= 0 && tick.time_msc > 0)
      tick_time = (datetime)(tick.time_msc / 1000);

   if(tick_time <= 0)
      return false;

   // Reset the clock whenever the chart symbol changes.
   if(g_cct_clock_symbol != symbol)
   {
      g_cct_clock_symbol = symbol;
      g_cct_clock_base_server_time = 0;
      g_cct_clock_base_local_ms = 0;
      g_cct_last_tick_time_msc = 0;
   }

   // Re-anchor only when the broker quote advances to a newer second.
   // This avoids local clock drift while preserving smooth one-second updates.
   if(g_cct_clock_base_server_time <= 0 || tick_time > g_cct_clock_base_server_time)
   {
      g_cct_clock_base_server_time = tick_time;
      g_cct_clock_base_local_ms = GetTickCount();
   }

   if(tick.time_msc > g_cct_last_tick_time_msc)
      g_cct_last_tick_time_msc = tick.time_msc;

   uint elapsed_ms = (uint)(GetTickCount() - g_cct_clock_base_local_ms);
   server_now = g_cct_clock_base_server_time + (datetime)(elapsed_ms / 1000);
   last_quote_time = tick_time;

   long age = (long)server_now - (long)last_quote_time;
   if(age < 0)
      age = 0;

   int max_age = InpCCT_MaxTickAgeSeconds;
   if(max_age < 1)
      max_age = 1;

   return (age <= max_age);
}

//+------------------------------------------------------------------+
//| Create the panel and its text label                              |
//+------------------------------------------------------------------+
bool CCT_CreateCountdownObjects()
{
   // The countdown label is created by the Sessions & News panel.
   return (ObjectFind(0,SN_PREFIX+"candle_timer")>=0);
}

//+------------------------------------------------------------------+
//| Safely set the displayed text                                     |
//+------------------------------------------------------------------+
void CCT_SetStatusText(const string text)
{
   color status_color=C_ACCENT;
   if(StringFind(text,"منتظر")>=0 || StringFind(text,"بسته")>=0 ||
      StringFind(text,"همگام")>=0 || StringFind(text,"داده")>=0 ||
      StringFind(text,"پشتیبانی")>=0)
      status_color=C_WARN;
   SN_SetLabel("candle_timer",text,status_color);
   ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| Update the countdown                                             |
//+------------------------------------------------------------------+
void CCT_UpdateCountdown()
{
   string symbol = ChartSymbol(0);
   ENUM_TIMEFRAMES timeframe = (ENUM_TIMEFRAMES)ChartPeriod(0);

   if(symbol == "")
      symbol = _Symbol;
   if(timeframe == PERIOD_CURRENT)
      timeframe = _Period;

   string tf_label = CCT_TimeframeLabel(timeframe);

   datetime server_time = 0;
   datetime last_quote_time = 0;
   bool has_fresh_quote = CCT_GetBrokerClock(symbol, server_time, last_quote_time);
   if(server_time <= 0)
   {
      CCT_SetStatusText(tf_label + "   |   منتظر داده بازار");
      return;
   }

   bool has_schedule = false;
   bool session_open = CCT_IsInsideQuoteSession(symbol, server_time, has_schedule);

   // A known closed quote session means there is no active candle countdown.
   if(has_schedule && !session_open)
   {
      CCT_SetStatusText(tf_label + "   |   بازار بسته است");
      return;
   }

   // On holidays or exceptional closures, the broker's weekly session
   // timetable may still say "open". A stale quote suppresses the timer.
   if(!has_fresh_quote)
   {
      CCT_SetStatusText(tf_label + "   |   داده زنده بازار موجود نیست");
      return;
   }
   datetime bar_open_time = iTime(symbol, timeframe, 0);
   if(bar_open_time <= 0)
   {
      CCT_SetStatusText(tf_label + "   |   منتظر داده کندل");
      return;
   }

   int period_seconds = PeriodSeconds(timeframe);
   datetime bar_close_time = CCT_CurrentBarCloseTime(timeframe, bar_open_time);
   if(period_seconds <= 0 || bar_close_time <= 0)
   {
      CCT_SetStatusText(tf_label + "   |   تایم‌فریم پشتیبانی نمی‌شود");
      return;
   }

   // If server quote time and candle history are temporarily out of sync,
   // never show a countdown longer than the selected candle period.
   if(server_time < bar_open_time)
   {
      CCT_SetStatusText(tf_label + "   |   در حال همگام‌سازی کندل");
      return;
   }

   // A stale current-bar timestamp means the next candle has not been
   // received/formed yet. Do not let an M1 chart display 02:00, 03:00, etc.
   if(server_time >= bar_close_time)
   {
      datetime refreshed_bar_open = iTime(symbol, timeframe, 0);
      if(refreshed_bar_open > bar_open_time)
      {
         bar_open_time = refreshed_bar_open;
         bar_close_time = CCT_CurrentBarCloseTime(timeframe, bar_open_time);
      }

      if(bar_close_time <= 0 || server_time >= bar_close_time)
      {
         CCT_SetStatusText(tf_label + "   |   منتظر کندل جدید");
         return;
      }
   }

   long remaining_seconds = (long)bar_close_time - (long)server_time;
   if(remaining_seconds < 0)
      remaining_seconds = 0;
   if(remaining_seconds > period_seconds)
   {
      CCT_SetStatusText(tf_label + "   |   در حال همگام‌سازی کندل");
      return;
   }

   string display_text = "کندل "+tf_label+"  |  بسته‌شدن در "+CCT_FormatCountdown(remaining_seconds);
   CCT_SetStatusText(display_text);
}

//+------------------------------------------------------------------+
//| Countdown module initialization                                         |
//+------------------------------------------------------------------+
int CCT_Init()
{
   if(!CCT_CreateCountdownObjects())
   {
      Print("ChartMasters: countdown label is missing from Sessions & News panel.");
      return INIT_FAILED;
   }
   CCT_UpdateCountdown();
   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Countdown module cleanup                                       |
//+------------------------------------------------------------------+
void CCT_Deinit(const int reason)
{
   // The countdown label belongs to Sessions & News and is removed there.
}

//+------------------------------------------------------------------+
//| Refresh once per second                                          |
//+------------------------------------------------------------------+
void CCT_Timer()
{
   CCT_UpdateCountdown();
}

//+------------------------------------------------------------------+
//| Refresh immediately when chart properties/timeframe change      |
//+------------------------------------------------------------------+
void CCT_ChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
{
   if(id == CHARTEVENT_CHART_CHANGE)
      CCT_UpdateCountdown();
}

//+------------------------------------------------------------------+
//| Required calculation event for a custom indicator                |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+

// ===== END INLINE MODULE: Modules/CandleCloseCountdown.mqh =====


// ===== BEGIN INLINE MODULE: Modules/NotesChecklistPanel.mqh =====
// NOTES & CHECKLIST PANEL
// Persists the quick note and checklist locally in the MT5 Common Files folder.

input group "=== Notes & Checklist Panel ==="
input int InpNC_X = 780;                 // Panel X position
input int InpNC_Y = 25;                  // Panel Y position

#define NC_PREFIX "CM_NC_"
#define NC_WIDTH 350
#define NC_HEIGHT 372
#define NC_ITEMS 6

string g_nc_note="";
bool g_nc_checked[NC_ITEMS];

string NC_FileName()
{
   string sym=_Symbol;
   StringReplace(sym,"/","_");
   StringReplace(sym,"\\","_");
   return "ChartMasters_TradingDashboard_"+IntegerToString((int)AccountInfoInteger(ACCOUNT_LOGIN))+"_"+sym+".txt";
}

void NC_Rect(string id,int x,int y,int w,int h,color bg,color border)
{
   string n=NC_PREFIX+id;
   if(ObjectFind(0,n)<0 && !ObjectCreate(0,n,OBJ_RECTANGLE_LABEL,0,0,0))
   {
      Print("Notes & Checklist: cannot create ",n,". Error: ",GetLastError());
      return;
   }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,n,OBJPROP_XSIZE,w);
   ObjectSetInteger(0,n,OBJPROP_YSIZE,h);
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg);
   ObjectSetInteger(0,n,OBJPROP_COLOR,border);
   ObjectSetInteger(0,n,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
   ObjectSetInteger(0,n,OBJPROP_ZORDER,2);
}

void NC_Label(string id,int x,int y,string value,color clr,int size=8)
{
   string n=NC_PREFIX+id;
   if(ObjectFind(0,n)<0 && !ObjectCreate(0,n,OBJ_LABEL,0,0,0))
   {
      Print("Notes & Checklist: cannot create ",n,". Error: ",GetLastError());
      return;
   }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetString(0,n,OBJPROP_TEXT,value);
   ObjectSetString(0,n,OBJPROP_FONT,"Tahoma");
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,size);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
   ObjectSetInteger(0,n,OBJPROP_ZORDER,3);
}

void NC_SetLabel(string id,string value,color clr)
{
   string n=NC_PREFIX+id;
   if(ObjectFind(0,n)<0) return;
   ObjectSetString(0,n,OBJPROP_TEXT,value);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
}

void NC_Button(string id,int x,int y,int w,int h,string value,color bg,color fg)
{
   string n=NC_PREFIX+id;
   if(ObjectFind(0,n)<0 && !ObjectCreate(0,n,OBJ_BUTTON,0,0,0))
   {
      Print("Notes & Checklist: cannot create button ",n,". Error: ",GetLastError());
      return;
   }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,n,OBJPROP_XSIZE,w);
   ObjectSetInteger(0,n,OBJPROP_YSIZE,h);
   ObjectSetString(0,n,OBJPROP_TEXT,value);
   ObjectSetString(0,n,OBJPROP_FONT,"Tahoma");
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,8);
   ObjectSetInteger(0,n,OBJPROP_COLOR,fg);
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg);
   ObjectSetInteger(0,n,OBJPROP_BORDER_COLOR,C_BORDER);
   ObjectSetInteger(0,n,OBJPROP_STATE,false);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,n,OBJPROP_ZORDER,5);
}

void NC_Edit(string id,int x,int y,int w,int h,string value)
{
   string n=NC_PREFIX+id;
   if(ObjectFind(0,n)<0 && !ObjectCreate(0,n,OBJ_EDIT,0,0,0))
   {
      Print("Notes & Checklist: cannot create edit ",n,". Error: ",GetLastError());
      return;
   }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,n,OBJPROP_XSIZE,w);
   ObjectSetInteger(0,n,OBJPROP_YSIZE,h);
   ObjectSetString(0,n,OBJPROP_TEXT,value);
   ObjectSetString(0,n,OBJPROP_FONT,"Tahoma");
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,9);
   ObjectSetInteger(0,n,OBJPROP_COLOR,C_TEXT);
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,C_BAR_BG);
   ObjectSetInteger(0,n,OBJPROP_BORDER_COLOR,C_BORDER);
   ObjectSetInteger(0,n,OBJPROP_ALIGN,ALIGN_LEFT);
   ObjectSetInteger(0,n,OBJPROP_READONLY,false);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,true);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,n,OBJPROP_ZORDER,4);
}

void NC_CreatePanel()
{
   int x=InpNC_X,y=InpNC_Y,pad=13;
   NC_Rect("bg",x,y,NC_WIDTH,NC_HEIGHT,C_BG,C_BORDER);
   NC_Rect("header",x,y,NC_WIDTH,42,C_HEADER,C_HEADER);
   NC_Rect("line",x,y+42,NC_WIDTH,2,C_ACCENT,C_ACCENT);
   NC_Label("title",x+pad,y+11,"یادداشت و چک‌لیست معامله",C_TEXT,11);

   NC_Label("note_title",x+pad,y+55,"یادداشت سریع",C_ACCENT,9);
   NC_Edit("note_edit",x+pad,y+76,230,27,g_nc_note);
   NC_Button("btn_save",x+252,y+76,84,27,"ذخیره",C_BTN,C_TEXT);

   NC_Label("check_title",x+pad,y+119,"چک‌لیست پیش از ورود",C_ACCENT,9);
   string items[NC_ITEMS]={
      "ساختار بازار و جهت معامله مشخص است",
      "نقدینگی یا ناحیه ورود تأیید شده",
      "تریگر ورود طبق پلن صادر شده",
      "حد ضرر پشت نقطه ابطال قرار دارد",
      "حجم معامله با ریسک مجاز هماهنگ است",
      "اخبار و سشن بررسی شده‌اند"
   };
   for(int i=0;i<NC_ITEMS;i++)
   {
      int row_y=y+148+i*28;
      NC_Button("check_"+IntegerToString(i),x+pad,row_y,27,22,"□",C_BTN,C_TEXT);
      NC_Label("item_"+IntegerToString(i),x+pad+37,row_y+5,items[i],C_TEXT,8);
   }

   NC_Rect("footer_line",x+pad,y+323,NC_WIDTH-2*pad,1,C_BORDER,C_BORDER);
   NC_Label("progress",x+pad,y+337,"۰ از ۶ مورد تکمیل شده",C_MUTED,8);
   NC_Button("btn_reset",x+NC_WIDTH-107,y+332,94,25,"بازنشانی",C_BTN,C_TEXT);
}

void NC_Load()
{
   ArrayInitialize(g_nc_checked,false);
   g_nc_note="";
   int h=FileOpen(NC_FileName(),FILE_READ|FILE_TXT|FILE_UNICODE|FILE_COMMON);
   if(h==INVALID_HANDLE) return;

   if(!FileIsEnding(h)) g_nc_note=FileReadString(h);
   for(int i=0;i<NC_ITEMS;i++)
   {
      if(FileIsEnding(h)) break;
      g_nc_checked[i]=(FileReadString(h)=="1");
   }
   FileClose(h);
}

bool NC_Save()
{
   int h=FileOpen(NC_FileName(),FILE_WRITE|FILE_TXT|FILE_UNICODE|FILE_COMMON);
   if(h==INVALID_HANDLE)
   {
      Print("Notes & Checklist: cannot save file. Error: ",GetLastError());
      return false;
   }
   FileWrite(h,g_nc_note);
   for(int i=0;i<NC_ITEMS;i++)
      FileWrite(h,g_nc_checked[i]? "1":"0");
   FileClose(h);
   return true;
}

void NC_UpdatePanel()
{
   int done=0;
   for(int i=0;i<NC_ITEMS;i++)
   {
      if(g_nc_checked[i]) done++;
      string button=NC_PREFIX+"check_"+IntegerToString(i);
      if(ObjectFind(0,button)>=0)
      {
         ObjectSetString(0,button,OBJPROP_TEXT,g_nc_checked[i]? "✓":"□");
         ObjectSetInteger(0,button,OBJPROP_BGCOLOR,g_nc_checked[i]? C_ACCENT:C_BTN);
         ObjectSetInteger(0,button,OBJPROP_COLOR,g_nc_checked[i]? C_BG:C_TEXT);
      }
   }
   NC_SetLabel("progress",IntegerToString(done)+" از "+IntegerToString(NC_ITEMS)+" مورد تکمیل شده",
               done==NC_ITEMS? C_ACCENT:C_MUTED);
}

bool NC_Init()
{
   NC_Load();
   NC_CreatePanel();
   NC_UpdatePanel();
   return true;
}

void NC_Deinit()
{
   string edit=NC_PREFIX+"note_edit";
   if(ObjectFind(0,edit)>=0) g_nc_note=ObjectGetString(0,edit,OBJPROP_TEXT);
   NC_Save();
   ObjectsDeleteAll(0,NC_PREFIX);
   ChartRedraw(0);
}

void NC_ChartEvent(const int id,const long &lparam,const double &dparam,const string &sparam)
{
   if(id==CHARTEVENT_OBJECT_CLICK)
   {
      if(sparam==NC_PREFIX+"btn_save")
      {
         g_nc_note=ObjectGetString(0,NC_PREFIX+"note_edit",OBJPROP_TEXT);
         NC_Save();
         NC_SetLabel("progress","یادداشت ذخیره شد",C_ACCENT);
         ObjectSetInteger(0,sparam,OBJPROP_STATE,false);
         return;
      }
      if(sparam==NC_PREFIX+"btn_reset")
      {
         for(int i=0;i<NC_ITEMS;i++) g_nc_checked[i]=false;
         NC_Save();
         NC_UpdatePanel();
         ObjectSetInteger(0,sparam,OBJPROP_STATE,false);
         return;
      }
      if(StringFind(sparam,NC_PREFIX+"check_")==0)
      {
         int index=(int)StringToInteger(StringSubstr(sparam,StringLen(NC_PREFIX)+6));
         if(index>=0 && index<NC_ITEMS)
         {
            g_nc_checked[index]=!g_nc_checked[index];
            NC_Save();
            NC_UpdatePanel();
         }
         ObjectSetInteger(0,sparam,OBJPROP_STATE,false);
      }
   }
   else if(id==CHARTEVENT_OBJECT_ENDEDIT && sparam==NC_PREFIX+"note_edit")
   {
      g_nc_note=ObjectGetString(0,sparam,OBJPROP_TEXT);
      NC_Save();
      NC_SetLabel("progress","یادداشت ذخیره شد",C_ACCENT);
   }
}

// ===== END INLINE MODULE: Modules/NotesChecklistPanel.mqh =====



//+------------------------------------------------------------------+
//| UI helpers                                                       |
//+------------------------------------------------------------------+
//--- object registry: tab of each panel object (-1 header, -2 tab bar, -3 status bar)
void Reg(string n)
  {
   if(gCurTab==-1) return;           // header objects are always visible
   int k=ArraySize(gObjs);
   ArrayResize(gObjs,k+1);
   ArrayResize(gObjTab,k+1);
   gObjs[k]=n;
   gObjTab[k]=gCurTab;
  }

void Rect(string name,int x,int y,int w,int h,color bg,color border)
  {
   string n=PFX+name;
   if(ObjectFind(0,n)<0) { ObjectCreate(0,n,OBJ_RECTANGLE_LABEL,0,0,0); Reg(n); }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,n,OBJPROP_XSIZE,w);
   ObjectSetInteger(0,n,OBJPROP_YSIZE,h);
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg);
   ObjectSetInteger(0,n,OBJPROP_BORDER_TYPE,BORDER_FLAT);
   ObjectSetInteger(0,n,OBJPROP_COLOR,border);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
   ObjectSetInteger(0,n,OBJPROP_BACK,false);
  }

void Lbl(string name,int x,int y,string txt,color clr,int size=9,string font="Segoe UI",
         ENUM_ANCHOR_POINT anchor=ANCHOR_LEFT_UPPER)
  {
   string n=PFX+name;
   if(ObjectFind(0,n)<0) { ObjectCreate(0,n,OBJ_LABEL,0,0,0); Reg(n); }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_ANCHOR,anchor);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetString(0,n,OBJPROP_TEXT,txt);
   ObjectSetString(0,n,OBJPROP_FONT,font);
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,size);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
  }

void SetTxt(string name,string txt,color clr)
  {
   string n=PFX+name;
   ObjectSetString(0,n,OBJPROP_TEXT,txt);
   ObjectSetInteger(0,n,OBJPROP_COLOR,clr);
  }

void Btn(string name,int x,int y,int w,int h,string txt,color bg,color fg=C_TEXT,int size=10)
  {
   string n=PFX+name;
   if(ObjectFind(0,n)<0) { ObjectCreate(0,n,OBJ_BUTTON,0,0,0); Reg(n); }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,n,OBJPROP_XSIZE,w);
   ObjectSetInteger(0,n,OBJPROP_YSIZE,h);
   ObjectSetString(0,n,OBJPROP_TEXT,txt);
   ObjectSetString(0,n,OBJPROP_FONT,"Segoe UI Semibold");
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,size);
   ObjectSetInteger(0,n,OBJPROP_COLOR,fg);
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg);
   ObjectSetInteger(0,n,OBJPROP_BORDER_COLOR,bg);
   ObjectSetInteger(0,n,OBJPROP_STATE,false);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
  }

void Edt(string name,int x,int y,int w,int h,string txt)
  {
   string n=PFX+name;
   if(ObjectFind(0,n)<0) { ObjectCreate(0,n,OBJ_EDIT,0,0,0); Reg(n); }
   ObjectSetInteger(0,n,OBJPROP_CORNER,CORNER_LEFT_UPPER);
   ObjectSetInteger(0,n,OBJPROP_XDISTANCE,x);
   ObjectSetInteger(0,n,OBJPROP_YDISTANCE,y);
   ObjectSetInteger(0,n,OBJPROP_XSIZE,w);
   ObjectSetInteger(0,n,OBJPROP_YSIZE,h);
   ObjectSetString(0,n,OBJPROP_TEXT,txt);
   ObjectSetString(0,n,OBJPROP_FONT,"Segoe UI Semibold");
   ObjectSetInteger(0,n,OBJPROP_FONTSIZE,10);
   ObjectSetInteger(0,n,OBJPROP_ALIGN,ALIGN_CENTER);
   ObjectSetInteger(0,n,OBJPROP_COLOR,C_ACCENT);
   ObjectSetInteger(0,n,OBJPROP_BGCOLOR,C_BAR_BG);
   ObjectSetInteger(0,n,OBJPROP_BORDER_COLOR,C_BORDER);
   ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
   ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
  }

//--- apply visibility + layout for the current tab (and minimize state)
void ApplyTab()
  {
   for(int i=0;i<ArraySize(gObjs);i++)
     {
      int tb=gObjTab[i];
      bool vis=(!gMin) && (tb<0 || tb==gTab);
      ObjectSetInteger(0,gObjs[i],OBJPROP_TIMEFRAMES,vis? OBJ_ALL_PERIODS : OBJ_NO_PERIODS);
     }

   // tab button colors
   for(int k=0;k<4;k++)
     {
      string n=PFX+"tab_"+IntegerToString(k);
      color bg=(k==gTab)? C_ACCENT : C_BTN;
      ObjectSetInteger(0,n,OBJPROP_BGCOLOR,bg);
      ObjectSetInteger(0,n,OBJPROP_BORDER_COLOR,bg);
      ObjectSetInteger(0,n,OBJPROP_COLOR,(k==gTab)? C_BG : C_TEXT);
     }

   // status bar sits right under the active tab's content
   int sy=InpPanelY+gTabH[gTab];
   ObjectSetInteger(0,PFX+"st_bg",OBJPROP_YDISTANCE,sy);
   ObjectSetInteger(0,PFX+"status",OBJPROP_YDISTANCE,sy+7);
   ObjectSetInteger(0,PFX+"bg",OBJPROP_YSIZE,gMin? 48 : gTabH[gTab]+28);
   ObjectSetString(0,PFX+"btn_min",OBJPROP_TEXT,gMin? "+" : "–");
   ChartRedraw();
  }


//+------------------------------------------------------------------+
//| helpers                                                           |
//+------------------------------------------------------------------+
string Sym(int code) { return ShortToString((ushort)code); }

bool IsDR(string n) { return StringFind(n, DR) == 0; }
bool IsUI(string n) { return StringFind(n, UI) == 0; }
bool InKind(string n, string k) { return StringFind(n, k) > 0; }
bool IsGrp(string n) { return InKind(n, "_LS_") || InKind(n, "_PD_") || InKind(n, "_GT_") || InKind(n, "_GC_"); }
string GroupBase(string n) { return StringSubstr(n, 0, StringLen(n) - 2); }
string Suffix(string n) { return StringSubstr(n, StringLen(n) - 2); }

bool CtrlDown()  { return TerminalInfoInteger(TERMINAL_KEYSTATE_CONTROL) < 0; }
bool ShiftDown() { return TerminalInfoInteger(TERMINAL_KEYSTATE_SHIFT) < 0; }

void Push(string &arr[], string v)
{
   int n = ArraySize(arr);
   ArrayResize(arr, n + 1);
   arr[n] = v;
}

int Anchors(long type)
{
   if(type == OBJ_HLINE || type == OBJ_ARROW_UP || type == OBJ_ARROW_DOWN || type == OBJ_TEXT) return 1;
   if(type == OBJ_TREND || type == OBJ_RECTANGLE || type == OBJ_FIBO) return 2;
   return 0;
}

int TfFlag()
{
   switch(_Period)
   {
      case PERIOD_M1:  return OBJ_PERIOD_M1;
      case PERIOD_M2:  return OBJ_PERIOD_M2;
      case PERIOD_M3:  return OBJ_PERIOD_M3;
      case PERIOD_M4:  return OBJ_PERIOD_M4;
      case PERIOD_M5:  return OBJ_PERIOD_M5;
      case PERIOD_M6:  return OBJ_PERIOD_M6;
      case PERIOD_M10: return OBJ_PERIOD_M10;
      case PERIOD_M12: return OBJ_PERIOD_M12;
      case PERIOD_M15: return OBJ_PERIOD_M15;
      case PERIOD_M20: return OBJ_PERIOD_M20;
      case PERIOD_M30: return OBJ_PERIOD_M30;
      case PERIOD_H1:  return OBJ_PERIOD_H1;
      case PERIOD_H2:  return OBJ_PERIOD_H2;
      case PERIOD_H3:  return OBJ_PERIOD_H3;
      case PERIOD_H4:  return OBJ_PERIOD_H4;
      case PERIOD_H6:  return OBJ_PERIOD_H6;
      case PERIOD_H8:  return OBJ_PERIOD_H8;
      case PERIOD_H12: return OBJ_PERIOD_H12;
      case PERIOD_D1:  return OBJ_PERIOD_D1;
      case PERIOD_W1:  return OBJ_PERIOD_W1;
      case PERIOD_MN1: return OBJ_PERIOD_MN1;
   }
   return OBJ_ALL_PERIODS;
}

double BalanceNow()
{
   if(InpBalanceOverride > 0) return InpBalanceOverride;
   string key = "RP_bal_" + _Symbol;
   if(GlobalVariableCheck(key)) return GlobalVariableGet(key);
   return AccountInfoDouble(ACCOUNT_BALANCE);
}

void BuildLabels()
{
   int n = ArraySize(I_id);
   ArrayResize(I_tx, n);
   ArrayResize(I_tp, n);
   string tx[] = {"", "", "", "", "", "", "Fx", "P/D", "", "", "", "T", "LNG", "SHT",
                  "", "", "U", "", "2px", "", "LCK", "ULK", "TF", "DEL", "CLR", "EXP", "IMP", "LST"};
   string tp[] = {"Select / cursor", "Trend line (text via edit bar)", "Horizontal line", "Ray", "Box", "Fib retracement",
                  "Fib extension", "Premium / Discount", "Curved arrow (3 clicks)", "Arrow up", "Arrow down", "Text",
                  "Long position", "Short position",
                  "Undo (Ctrl+Z)", "Redo (Ctrl+Y)", "Magnet (hold Ctrl)", "Color", "Line width", "Line style",
                  "Lock selected", "Unlock all", "Show selected only on this timeframe (toggle)", "Delete selected (Del)",
                  "Delete ALL drawings", "Export drawings to file", "Import drawings from file (replaces current)", "Objects list: select, timeframe visibility, delete"};
   for(int i = 0; i < n; i++) { I_tx[i] = tx[i]; I_tp[i] = tp[i]; }

   I_tx[0]  = Sym(0x2196);   // select
   I_tx[1]  = Sym(0x2571);   // trend
   I_tx[2]  = Sym(0x2500);   // hline
   I_tx[3]  = Sym(0x2197);   // ray
   I_tx[4]  = Sym(0x25AD);   // box
   I_tx[5]  = Sym(0x2261);   // fib
   I_tx[8]  = Sym(0x21AA);   // curved arrow
   I_tx[9]  = Sym(0x25B2);   // up
   I_tx[10] = Sym(0x25BC);   // down
   I_tx[14] = Sym(0x21B6);   // undo
   I_tx[15] = Sym(0x21B7);   // redo
   I_tx[17] = Sym(0x25CF);   // color
   I_tx[19] = Sym(0x2501);   // style
}

//+------------------------------------------------------------------+
//| fibonacci levels                                                  |
//+------------------------------------------------------------------+
void SetupFibo(string name, color c)
{
   double lv[];
   if(StringFind(name, "_FX_") > 0)
   {
      double e[] = {0.0, 0.618, 1.0, 1.272, 1.618, 2.0, 2.618};
      ArrayCopy(lv, e);
   }
   else
   {
      double r[] = {0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0};
      ArrayCopy(lv, r);
   }
   int n = ArraySize(lv);
   ObjectSetInteger(0, name, OBJPROP_LEVELS, n);
   for(int i = 0; i < n; i++)
   {
      ObjectSetDouble(0, name, OBJPROP_LEVELVALUE, i, lv[i]);
      ObjectSetInteger(0, name, OBJPROP_LEVELCOLOR, i, c);
      ObjectSetInteger(0, name, OBJPROP_LEVELSTYLE, i, STYLE_SOLID);
      ObjectSetInteger(0, name, OBJPROP_LEVELWIDTH, i, 1);
      ObjectSetString(0, name, OBJPROP_LEVELTEXT, i, DoubleToString(lv[i] * 100.0, 1) + "% (%$)");
   }
   ObjectSetInteger(0, name, OBJPROP_COLOR, c);
}


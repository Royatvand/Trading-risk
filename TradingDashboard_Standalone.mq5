   string s2="Trailing stop:  "+(InpUseTrail? "ON   (start "+IntegerToString(InpTrailStart)+", dist "+IntegerToString(InpTrailDist)+")" : "OFF");
   string s3="Partial close:  "+DoubleToString(InpPartialPct,0)+"% of volume";

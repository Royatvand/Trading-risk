void MakeBtn(string id, string text, int w, int h, color bg, color fg, string tip, int fs)
{
   string name = UI + id;
   if(ObjectFind(0, name) < 0) ObjectCreate(0, name, OBJ_BUTTON, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_XSIZE, w);
   ObjectSetInteger(0, name, OBJPROP_YSIZE, h);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetString(0, name, OBJPROP_FONT, FONT_UI);
   ObjectSetInteger(0, name, OBJPROP_COLOR, fg);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, bg);
   ObjectSetInteger(0, name, OBJPROP_BORDER_COLOR, C'70,70,90');
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, fs);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, name, OBJPROP_ZORDER, 10);
   ObjectSetString(0, name, OBJPROP_TOOLTIP, tip);
}

void PlaceUI(string id, int x, int y)
{
   ObjectSetInteger(0, UI + id, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, UI + id, OBJPROP_YDISTANCE, y);
}

void ShowUI(string id, bool show)
{
   ObjectSetInteger(0, UI + id, OBJPROP_TIMEFRAMES, show ? OBJ_ALL_PERIODS : OBJ_NO_PERIODS);
}

void MakeRectUI(string id, color bg)
{
   string name = UI + id;
   if(ObjectFind(0, name) < 0) ObjectCreate(0, name, OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, name, OBJPROP_BGCOLOR, bg);
   ObjectSetInteger(0, name, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, name, OBJPROP_COLOR, C'70,70,90');
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
}

void CreateUI()
{
   BuildLabels();

   // toolbar is one bitmap (anti-aliased icons, hover / active states)
   string tb = UI + "tb";
   if(ObjectFind(0, tb) < 0) ObjectCreate(0, tb, OBJ_BITMAP_LABEL, 0, 0, 0);
   ObjectSetInteger(0, tb, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, tb, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, tb, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, tb, OBJPROP_ZORDER, 10);

   string tip = UI + "tip";
   if(ObjectFind(0, tip) < 0) ObjectCreate(0, tip, OBJ_EDIT, 0, 0, 0);
   ObjectSetInteger(0, tip, OBJPROP_READONLY, true);
   ObjectSetInteger(0, tip, OBJPROP_XSIZE, 120);
   ObjectSetInteger(0, tip, OBJPROP_YSIZE, 20);
   ObjectSetInteger(0, tip, OBJPROP_COLOR, clrWhite);
   ObjectSetInteger(0, tip, OBJPROP_BGCOLOR, C'20,24,32');
   ObjectSetInteger(0, tip, OBJPROP_BORDER_COLOR, C'70,70,90');
   ObjectSetString(0, tip, OBJPROP_FONT, "Segoe UI");
   ObjectSetInteger(0, tip, OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, tip, OBJPROP_ALIGN, ALIGN_CENTER);
   ObjectSetInteger(0, tip, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, tip, OBJPROP_HIDDEN, true);
   ObjectSetInteger(0, tip, OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS);

   // floating edit bar
   MakeRectUI("fb_bg", C'30,30,44');
   MakeBtn("fb_col",  Sym(0x25CF), 28, 24, g_color, clrWhite, "Color", 10);
   MakeBtn("fb_wid",  "2px", 44, 24, C'40,40,56', clrWhite, "Line width", 9);
   MakeBtn("fb_sty",  Sym(0x2501), 28, 24, C'40,40,56', clrWhite, "Line style", 10);
   string te = UI + "fb_txt";
   if(ObjectFind(0, te) < 0) ObjectCreate(0, te, OBJ_EDIT, 0, 0, 0);
   ObjectSetInteger(0, te, OBJPROP_XSIZE, 92);
   ObjectSetInteger(0, te, OBJPROP_YSIZE, 24);
   ObjectSetString(0, te, OBJPROP_TEXT, "");
   ObjectSetInteger(0, te, OBJPROP_COLOR, clrBlack);
   ObjectSetInteger(0, te, OBJPROP_BGCOLOR, clrWhite);
   ObjectSetInteger(0, te, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, te, OBJPROP_HIDDEN, true);
   ObjectSetString(0, te, OBJPROP_TOOLTIP, "Text on the line / text object (press Enter)");
   MakeBtn("fb_fill", Sym(0x25A6), 28, 24, C'40,40,56', clrWhite, "Fill on/off (box)", 10);
   MakeBtn("fb_tf",   "TF", 28, 24, C'40,40,56', clrWhite, "Show only on this timeframe (toggle)", 9);
   MakeBtn("fb_lock", "LCK", 34, 24, C'40,40,56', clrWhite, "Lock", 8);
   MakeBtn("fb_del",  "DEL", 34, 24, C'110,40,40', clrWhite, "Delete", 8);

   // palette popup
   MakeRectUI("pal_bg", C'30,30,44');
   for(int i = 0; i < 8; i++)
      MakeBtn("pal" + IntegerToString(i), "", 22, 22, PAL[i], clrWhite, "Color", 8);

   HideFB();
   PalHide();
   CreateList();
   LayoutToolbar();
   UpdateButtons();
}

bool ItemActive(int i)
{
   ENUM_TOOL tools[] = {T_NONE, T_TL, T_HL, T_RAY, T_BOX, T_FIB, T_FIBX, T_PD, T_CA, T_ARU, T_ARD, T_TXT, T_LONG, T_SHORT};
   if(i < ArraySize(tools)) return (g_tool == tools[i]);
   if(I_id[i] == "mag") return g_magnet;
   if(I_id[i] == "lst") return g_lsOpen;
   return false;
}

int ItemIndex(string id)
{
   for(int i = 0; i < ArraySize(I_id); i++) if(I_id[i] == id) return i;
   return -1;
}

uint BlendOver(uint dst, uint src)
{
   uint sa = (src >> 24) & 0xFF;
   if(sa == 0) return dst;
   if(sa == 255) return src;
   uint da = (dst >> 24) & 0xFF;
   double sA = sa / 255.0, dA = da / 255.0;
   double oA = sA + dA * (1.0 - sA);
   if(oA <= 0.0) return 0;
   double r = (((src >> 16) & 0xFF) * sA + ((dst >> 16) & 0xFF) * dA * (1.0 - sA)) / oA;
   double g = (((src >> 8) & 0xFF) * sA + ((dst >> 8) & 0xFF) * dA * (1.0 - sA)) / oA;
   double b = ((src & 0xFF) * sA + (dst & 0xFF) * dA * (1.0 - sA)) / oA;
   return ((uint)MathRound(oA * 255.0) << 24) | ((uint)MathRound(r) << 16) | ((uint)MathRound(g) << 8) | (uint)MathRound(b);
}

double RRCover(double px, double py, double w, double h, double r)
{
   double qx = MathAbs(px - w / 2.0) - (w / 2.0 - r);
   double qy = MathAbs(py - h / 2.0) - (h / 2.0 - r);
   double ox = MathMax(qx, 0.0), oy = MathMax(qy, 0.0);
   double d = MathSqrt(ox * ox + oy * oy) + MathMin(MathMax(qx, qy), 0.0) - r;
   return MathMax(0.0, MathMin(1.0, 0.5 - d));
}

void FillRR(int bw, int bh, int x0, int y0, int w, int h, double r, uint rgb, uint alpha)
{
   for(int yy = 0; yy < h; yy++)
      for(int xx = 0; xx < w; xx++)
      {
         double c = RRCover(xx + 0.5, yy + 0.5, w, h, r);
         if(c <= 0.0) continue;
         int px = x0 + xx, py = y0 + yy;
         if(px < 0 || py < 0 || px >= bw || py >= bh) continue;
         uint a = (uint)MathRound(c * alpha);
         g_bmp[py * bw + px] = BlendOver(g_bmp[py * bw + px], (a << 24) | rgb);
      }
}

void FillDot(int bw, int bh, double cx, double cy, double r, uint argb)
{
   int x0 = (int)MathFloor(cx - r - 1), x1 = (int)MathCeil(cx + r + 1);
   int y0 = (int)MathFloor(cy - r - 1), y1 = (int)MathCeil(cy + r + 1);
   uint al = (argb >> 24) & 0xFF;
   for(int y = y0; y <= y1; y++)
      for(int x = x0; x <= x1; x++)
      {
         if(x < 0 || y < 0 || x >= bw || y >= bh) continue;
         double d = MathSqrt((x + 0.5 - cx) * (x + 0.5 - cx) + (y + 0.5 - cy) * (y + 0.5 - cy));
         double c = MathMax(0.0, MathMin(1.0, r + 0.5 - d));
         if(c <= 0.0) continue;
         uint a = (uint)MathRound(c * al);
         g_bmp[y * bw + x] = BlendOver(g_bmp[y * bw + x], (a << 24) | (argb & 0x00FFFFFF));
      }
}

void RenderToolbar()
{
   int w = g_tbW, h = g_tbH;
   if(w <= 0 || h <= 0) return;
   ArrayResize(g_bmp, w * h);
   ArrayInitialize(g_bmp, 0);

   FillRR(w, h, 0, 0, w, h, 11.0, 0x3A4150, 200);          // thin border
   FillRR(w, h, 1, 1, w - 2, h - 2, 10.0, 0x161A22, 240);  // body

   // drag handle (six dots)
   for(int gr = 0; gr < 3; gr++)
      for(int gc = 0; gc < 2; gc++)
         FillDot(w, h, 9.0 + gc * 5.0, h / 2.0 + (gr - 1) * 6.0, 1.5, 0xFF7A8296);

   int n = ArraySize(I_id);
   for(int i = 0; i < n; i++)
   {
      int cx = PADT + GRIP + (i % g_tbCols) * (CELL + CGAP);
      int cy = PADT + (i / g_tbCols) * (CELL + CGAP);
      bool act = ItemActive(i), hov = (i == g_hover);
      if(act)      FillRR(w, h, cx, cy, CELL, CELL, 8.0, 0x2F6BFF, 255);
      else if(hov) FillRR(w, h, cx, cy, CELL, CELL, 8.0, 0x2E3542, 255);

      if(I_id[i] == "col")
      {
         FillDot(w, h, cx + CELL / 2.0, cy + CELL / 2.0, 9.5, 0xFFE6EAF2);
         FillDot(w, h, cx + CELL / 2.0, cy + CELL / 2.0, 7.5, (uint)ColorToARGB(g_color, 255));
      }
      else
      {
         int ox = cx + (CELL - IC) / 2, oy = cy + (CELL - IC) / 2;
         int base = i * IC * IC;
         for(int yy = 0; yy < IC; yy++)
            for(int xx = 0; xx < IC; xx++)
            {
               uint src = ICON_DATA[base + yy * IC + xx];
               if((src >> 24) == 0) continue;
               int idx = (oy + yy) * w + (ox + xx);
               g_bmp[idx] = BlendOver(g_bmp[idx], src);
            }
      }
      if(i == 14 && (i % g_tbCols) > 0)    // separator between tools and actions
         FillRR(w, h, cx - 2, cy + 6, 1, CELL - 12, 0.5, 0x4A5264, 255);
   }

   g_tbIdx = 1 - g_tbIdx;
   string res = "::dp_tb" + IntegerToString(g_tbIdx);
   ResourceCreate(res, g_bmp, w, h, 0, 0, w, COLOR_FORMAT_ARGB_NORMALIZE);
   ObjectSetString(0, UI + "tb", OBJPROP_BMPFILE, res);
}

void LayoutToolbar()
{
   int W = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int H = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
   int n = ArraySize(I_id);
   int cols = MathMax(1, MathMin(n, (W - 2 * InpLeft - 2 * PADT - GRIP + CGAP) / (CELL + CGAP)));
   int rows = (n + cols - 1) / cols;
   g_tbCols = cols;
   g_tbW = 2 * PADT + GRIP + cols * (CELL + CGAP) - CGAP;
   g_tbH = 2 * PADT + rows * (CELL + CGAP) - CGAP;
   g_tbX = InpLeft;
   g_tbY = H - InpBottom - g_tbH;
   if(g_tbMoved)
   {
      g_tbX = MathMax(0, MathMin(W - g_tbW, g_tbCX));
      g_tbY = MathMax(0, MathMin(H - g_tbH, g_tbCY));
   }
   ObjectSetInteger(0, UI + "tb", OBJPROP_XDISTANCE, g_tbX);
   ObjectSetInteger(0, UI + "tb", OBJPROP_YDISTANCE, g_tbY);
   RenderToolbar();
   ChartRedraw(0);
}

void UpdateButtons()
{
   RenderToolbar();
   ChartRedraw(0);
}

// which toolbar cell is under the pointer (-1 = none)
int ItemAt(int x, int y)
{
   int rx = x - g_tbX - PADT - GRIP, ry = y - g_tbY - PADT;
   if(rx < 0 || ry < 0) return -1;
   int c = rx / (CELL + CGAP), r = ry / (CELL + CGAP);
   if((rx % (CELL + CGAP)) >= CELL || (ry % (CELL + CGAP)) >= CELL) return -1;
   if(c >= g_tbCols) return -1;
   int i = r * g_tbCols + c;
   if(i < 0 || i >= ArraySize(I_id)) return -1;
   return i;
}

void HideTip() { ObjectSetInteger(0, UI + "tip", OBJPROP_TIMEFRAMES, OBJ_NO_PERIODS); }

void ShowTip(int i)
{
   string txt = I_tp[i];
   int W = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int tw = 16 + StringLen(txt) * 6;
   int tx = g_tbX + PADT + GRIP + (i % g_tbCols) * (CELL + CGAP);
   tx = MathMax(4, MathMin(W - tw - 4, tx));
   int ty = g_tbY - 26;
   if(ty < 2) ty = g_tbY + g_tbH + 4;
   ObjectSetString(0, UI + "tip", OBJPROP_TEXT, txt);
   ObjectSetInteger(0, UI + "tip", OBJPROP_XSIZE, tw);
   ObjectSetInteger(0, UI + "tip", OBJPROP_XDISTANCE, tx);
   ObjectSetInteger(0, UI + "tip", OBJPROP_YDISTANCE, ty);
   ObjectSetInteger(0, UI + "tip", OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
}

bool InGrip(int x, int y)
{
   return (x >= g_tbX && x <= g_tbX + PADT + GRIP && y >= g_tbY && y <= g_tbY + g_tbH);
}

// drag the toolbar by its handle; returns true while dragging
bool DragToolbar(int x, int y, int flags)
{
   bool down = ((flags & 1) != 0);
   if(!g_drag)
   {
      if(down && g_clicks == 0 && InGrip(x, y))
      {
         g_drag = true;
         g_dragDX = x - g_tbX;
         g_dragDY = y - g_tbY;
         g_prevScroll = ChartGetInteger(0, CHART_MOUSE_SCROLL);
         ChartSetInteger(0, CHART_MOUSE_SCROLL, false);
         HideTip();
      }
      return g_drag;
   }
   if(down)
   {
      int W = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
      int H = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
      g_tbX = MathMax(0, MathMin(W - g_tbW, x - g_dragDX));
      g_tbY = MathMax(0, MathMin(H - g_tbH, y - g_dragDY));
      ObjectSetInteger(0, UI + "tb", OBJPROP_XDISTANCE, g_tbX);
      ObjectSetInteger(0, UI + "tb", OBJPROP_YDISTANCE, g_tbY);
      ChartRedraw(0);
      return true;
   }
   // released
   g_drag = false;
   g_tbMoved = true;
   g_tbCX = g_tbX;
   g_tbCY = g_tbY;
   GlobalVariableSet("DPN_tbx", g_tbCX);
   GlobalVariableSet("DPN_tby", g_tbCY);
   ChartSetInteger(0, CHART_MOUSE_SCROLL, g_prevScroll != 0);
   return false;
}

void HoverUpdate(int x, int y)
{
   int idx = -1;
   if(x >= g_tbX && x <= g_tbX + g_tbW && y >= g_tbY && y <= g_tbY + g_tbH) idx = ItemAt(x, y);
   if(idx == g_hover) return;
   g_hover = idx;
   RenderToolbar();
   if(idx >= 0) ShowTip(idx); else HideTip();
   ChartRedraw(0);
}

void ResetButtons()
{
   for(int i = 0; i < ArraySize(I_id); i++) ObjectSetInteger(0, UI + I_id[i], OBJPROP_STATE, false);
   string f[] = {"fb_col", "fb_wid", "fb_sty", "fb_fill", "fb_tf", "fb_lock", "fb_del"};
   for(int i = 0; i < ArraySize(f); i++) ObjectSetInteger(0, UI + f[i], OBJPROP_STATE, false);
   for(int i = 0; i < 8; i++) ObjectSetInteger(0, UI + "pal" + IntegerToString(i), OBJPROP_STATE, false);
   for(int i = 0; i < ArraySize(g_lsIds); i++) ObjectSetInteger(0, UI + g_lsIds[i], OBJPROP_STATE, false);
}

//+------------------------------------------------------------------+
//| palette popup                                                     |
//+------------------------------------------------------------------+
void PalHide()
{
   g_palOpen = false;
   ShowUI("pal_bg", false);
   for(int i = 0; i < 8; i++) ShowUI("pal" + IntegerToString(i), false);
}

void PalShow(int x, int y)
{
   g_palOpen = true;
   g_palX = x;
   g_palY = y;
   ObjectSetInteger(0, UI + "pal_bg", OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, UI + "pal_bg", OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, UI + "pal_bg", OBJPROP_XSIZE, 8 * 24 + 4);
   ObjectSetInteger(0, UI + "pal_bg", OBJPROP_YSIZE, 28);
   ShowUI("pal_bg", true);
   for(int i = 0; i < 8; i++)
   {
      PlaceUI("pal" + IntegerToString(i), x + 3 + i * 24, y + 3);
      ShowUI("pal" + IntegerToString(i), true);
   }
}

//+------------------------------------------------------------------+
//| snapshots for undo / redo                                         |
//+------------------------------------------------------------------+
string Clean(string s)
{
   StringReplace(s, "|", " ");
   StringReplace(s, "~", " ");
   return s;
}

string Ser(string name)
{
   long type = ObjectGetInteger(0, name, OBJPROP_TYPE);
   string s = name + "|" + IntegerToString(type);
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_TIME, 0));
   s += "|" + DoubleToString(ObjectGetDouble(0, name, OBJPROP_PRICE, 0), 8);
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_TIME, 1));
   s += "|" + DoubleToString(ObjectGetDouble(0, name, OBJPROP_PRICE, 1), 8);
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_COLOR));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_WIDTH));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_STYLE));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_BACK));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_FILL));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_RAY_RIGHT));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_SELECTABLE));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_TIMEFRAMES));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_FONTSIZE));
   s += "|" + IntegerToString(ObjectGetInteger(0, name, OBJPROP_ANCHOR));
   s += "|" + DoubleToString(ObjectGetDouble(0, name, OBJPROP_ANGLE), 2);
   s += "|#" + Clean(ObjectGetString(0, name, OBJPROP_TEXT));
   return s;
}

string Snapshot()
{
   string snap = "";
   int total = ObjectsTotal(0);
   for(int i = 0; i < total; i++)
   {
      string name = ObjectName(0, i);
      if(!IsDR(name)) continue;
      if(Anchors(ObjectGetInteger(0, name, OBJPROP_TYPE)) == 0) continue;
      if(snap != "") snap += "~";
      snap += Ser(name);
   }
   return snap;
}

void DeleteAllDR()
{
   for(int i = ObjectsTotal(0) - 1; i >= 0; i--)
   {
      string name = ObjectName(0, i);
      if(IsDR(name)) ObjectDelete(0, name);
   }
}

void RefreshAllTL()
{
   for(int i = 0; i < ObjectsTotal(0); i++)
   {
      string name = ObjectName(0, i);
      if(IsDR(name) && InKind(name, "_GT_") && Suffix(name) == "ln")
         RefreshTL(GroupBase(name));
   }
}

void Restore(string snap)
{
   g_busy = true;
   DeleteAllDR();
   if(snap != "")
   {
      string items[];
      int n = StringSplit(snap, '~', items);
      for(int i = 0; i < n; i++)
      {
         string f[];
         if(StringSplit(items[i], '|', f) < 18) continue;
         string name = f[0];
         long type = StringToInteger(f[1]);
         datetime t0 = (datetime)StringToInteger(f[2]);
         double p0 = StringToDouble(f[3]);
         datetime t1 = (datetime)StringToInteger(f[4]);
         double p1 = StringToDouble(f[5]);
         int an = Anchors(type);
         bool ok = false;
         if(an == 2)                 ok = ObjectCreate(0, name, (ENUM_OBJECT)type, 0, t0, p0, t1, p1);
         else if(type == OBJ_HLINE)  ok = ObjectCreate(0, name, OBJ_HLINE, 0, 0, p0);
         else if(an == 1)            ok = ObjectCreate(0, name, (ENUM_OBJECT)type, 0, t0, p0);
         if(!ok) continue;

         color c = (color)StringToInteger(f[6]);
         ObjectSetInteger(0, name, OBJPROP_COLOR, c);
         ObjectSetInteger(0, name, OBJPROP_WIDTH, StringToInteger(f[7]));
         ObjectSetInteger(0, name, OBJPROP_STYLE, StringToInteger(f[8]));
         ObjectSetInteger(0, name, OBJPROP_BACK, StringToInteger(f[9]) != 0);
         ObjectSetInteger(0, name, OBJPROP_FILL, StringToInteger(f[10]) != 0);
         ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, StringToInteger(f[11]) != 0);
         ObjectSetInteger(0, name, OBJPROP_SELECTABLE, StringToInteger(f[12]) != 0);
         ObjectSetInteger(0, name, OBJPROP_TIMEFRAMES, StringToInteger(f[13]));
         ObjectSetInteger(0, name, OBJPROP_HIDDEN, false);
         if(type == OBJ_TEXT)
         {
            ObjectSetInteger(0, name, OBJPROP_FONTSIZE, StringToInteger(f[14]));
            ObjectSetInteger(0, name, OBJPROP_ANCHOR, StringToInteger(f[15]));
            ObjectSetDouble(0, name, OBJPROP_ANGLE, StringToDouble(f[16]));
            ObjectSetString(0, name, OBJPROP_TEXT, StringSubstr(f[17], 1));
         }
         if(type == OBJ_FIBO) SetupFibo(name, c);
      }
   }
   g_busy = false;
   RefreshAllTL();
   ChartRedraw(0);
}

void PushSnap()
{
   if(g_busy) return;
   string s = Snapshot();
   if(g_ui >= 0 && g_stack[g_ui] == s) return;
   int n = g_ui + 1;
   ArrayResize(g_stack, n + 1);
   g_stack[n] = s;
   g_ui = n;
   if(ArraySize(g_stack) > 60)
   {
      for(int i = 0; i < ArraySize(g_stack) - 1; i++) g_stack[i] = g_stack[i + 1];
      ArrayResize(g_stack, ArraySize(g_stack) - 1);
      g_ui = ArraySize(g_stack) - 1;
   }
}

void Undo()
{
   if(g_ui <= 0) return;
   g_ui--;
   Restore(g_stack[g_ui]);
   UpdateFB(true);
}

void Redo()
{
   if(g_ui >= ArraySize(g_stack) - 1) return;
   g_ui++;
   Restore(g_stack[g_ui]);
   UpdateFB(true);
}

//+------------------------------------------------------------------+
//| object creation helpers                                           |
//+------------------------------------------------------------------+
string NewName(string kind)
{
   g_id++;
   return DR + kind + "_" + IntegerToString(g_id);
}

string NewBase(string kind)
{
   g_id++;
   return DR + kind + "_" + IntegerToString(g_id) + "_";
}

void SeedId()
{
   g_id = 0;
   for(int i = 0; i < ObjectsTotal(0); i++)
   {
      string name = ObjectName(0, i);
      if(!IsDR(name)) continue;
      string parts[];
      if(StringSplit(name, '_', parts) >= 3)
         g_id = MathMax(g_id, (int)StringToInteger(parts[2]));
   }
}

void StyleObj(string name)
{
   ObjectSetInteger(0, name, OBJPROP_COLOR, g_color);
   ObjectSetInteger(0, name, OBJPROP_WIDTH, g_width);
   ObjectSetInteger(0, name, OBJPROP_STYLE, g_style);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, true);
   ObjectSetInteger(0, name, OBJPROP_SELECTED, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, false);
}

void ClearSel()
{
   for(int i = 0; i < ObjectsTotal(0); i++)
   {
      string name = ObjectName(0, i);
      if(IsDR(name)) ObjectSetInteger(0, name, OBJPROP_SELECTED, false);
   }
}

void SelectObj(string name, bool add)
{
   if(!add) ClearSel();
   if(ObjectGetInteger(0, name, OBJPROP_SELECTABLE))
      ObjectSetInteger(0, name, OBJPROP_SELECTED, true);
}

void Members(string base, string &out[])
{
   ArrayResize(out, 0);
   for(int i = 0; i < ObjectsTotal(0); i++)
   {
      string nm = ObjectName(0, i);
      if(StringFind(nm, base) == 0) Push(out, nm);
   }
}

void DeleteBase(string base)
{
   for(int i = ObjectsTotal(0) - 1; i >= 0; i--)
   {
      string nm = ObjectName(0, i);
      if(StringFind(nm, base) == 0) ObjectDelete(0, nm);
   }
}

//+------------------------------------------------------------------+
//| group: long / short                                               |
//+------------------------------------------------------------------+
double BalanceRiskLots(double dist, double &riskMoney)
{
   riskMoney = BalanceNow() * InpRiskPct / 100.0;
   double ts = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   double tv = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   if(ts <= 0) ts = _Point;
   if(step <= 0) step = 0.01;
   if(dist <= 0 || tv <= 0) return 0.0;
   double lossPerLot = dist / ts * tv;
   double lots = MathFloor(riskMoney / lossPerLot / step + 1e-9) * step;
   if(lots < minLot) lots = minLot;
   return NormalizeDouble(lots, 2);
}

void LSApply(string base, datetime t1, datetime t2, double entry, double sl, double tp)
{
   ObjectMove(0, base + "tp", 0, t1, entry);
   ObjectMove(0, base + "tp", 1, t2, tp);
   ObjectMove(0, base + "sl", 0, t1, entry);
   ObjectMove(0, base + "sl", 1, t2, sl);

   bool lng = (tp > entry);
   double risk = MathAbs(entry - sl), rew = MathAbs(tp - entry);
   double rr = (risk > 0 ? rew / risk : 0.0);
   double riskMoney = 0;
   double lots = BalanceRiskLots(risk, riskMoney);
   string txt = StringFormat("%s  R:R %.2f  Lots %.2f  Risk %.2f", lng ? "LONG" : "SHORT", rr, lots, riskMoney);

   ObjectMove(0, base + "lb", 0, t1, tp);
   ObjectSetInteger(0, base + "lb", OBJPROP_ANCHOR, lng ? ANCHOR_LEFT_LOWER : ANCHOR_LEFT_UPPER);
   ObjectSetString(0, base + "lb", OBJPROP_TEXT, txt);
}

void MakeLS(string base, datetime t1, double entry, double sl)
{
   int ps = PeriodSeconds();
   datetime t2 = t1 + (datetime)(InpLSBars * ps);
   double tp = entry + (entry - sl) * InpDPP_RR;

   ObjectCreate(0, base + "tp", OBJ_RECTANGLE, 0, t1, entry, t2, tp);
   ObjectCreate(0, base + "sl", OBJ_RECTANGLE, 0, t1, entry, t2, sl);
   ObjectCreate(0, base + "lb", OBJ_TEXT, 0, t1, tp);

   string tpn = base + "tp", sln = base + "sl", lbn = base + "lb";
   ObjectSetInteger(0, tpn, OBJPROP_COLOR, InpProfitColor);
   ObjectSetInteger(0, sln, OBJPROP_COLOR, InpLossColor);
   string rects[2];
   rects[0] = tpn; rects[1] = sln;
   for(int i = 0; i < 2; i++)
   {
      ObjectSetInteger(0, rects[i], OBJPROP_FILL, true);
      ObjectSetInteger(0, rects[i], OBJPROP_BACK, true);
      ObjectSetInteger(0, rects[i], OBJPROP_SELECTABLE, true);
      ObjectSetInteger(0, rects[i], OBJPROP_SELECTED, false);
      ObjectSetInteger(0, rects[i], OBJPROP_HIDDEN, false);
   }
   ObjectSetInteger(0, lbn, OBJPROP_COLOR, clrWhite);
   ObjectSetInteger(0, lbn, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, lbn, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, lbn, OBJPROP_SELECTED, false);
   ObjectSetInteger(0, lbn, OBJPROP_HIDDEN, false);

   LSApply(base, t1, t2, entry, sl, tp);
}

void RefreshLS(string base)
{
   if(ObjectFind(0, base + "tp") < 0 || ObjectFind(0, base + "sl") < 0 || ObjectFind(0, base + "lb") < 0) return;
   datetime t1 = (datetime)ObjectGetInteger(0, base + "tp", OBJPROP_TIME, 0);
   datetime t2 = (datetime)ObjectGetInteger(0, base + "tp", OBJPROP_TIME, 1);
   double entry = ObjectGetDouble(0, base + "tp", OBJPROP_PRICE, 0);
   double tp    = ObjectGetDouble(0, base + "tp", OBJPROP_PRICE, 1);
   double sl    = ObjectGetDouble(0, base + "sl", OBJPROP_PRICE, 1);
   LSApply(base, t1, t2, entry, sl, tp);
}

//+------------------------------------------------------------------+
//| group: premium / discount (filled halves + equilibrium)           |
//+------------------------------------------------------------------+
void PDSet(string base, datetime tl, datetime tr, double hi, double lo)
{
   double mid = (hi + lo) / 2.0;
   ObjectMove(0, base + "pr", 0, tl, hi);
   ObjectMove(0, base + "pr", 1, tr, mid);
   ObjectMove(0, base + "ds", 0, tl, mid);
   ObjectMove(0, base + "ds", 1, tr, lo);
   ObjectMove(0, base + "md", 0, tl, mid);
   ObjectMove(0, base + "md", 1, tr, mid);
   ObjectMove(0, base + "pm", 0, tr, hi);
   ObjectMove(0, base + "dc", 0, tr, lo);
   ObjectMove(0, base + "eq", 0, tr, mid);
}

// recompute from the part that was dragged (halves stay equal)
void PDApply(string base, string part)
{
   if(ObjectFind(0, base + "pr") < 0 || ObjectFind(0, base + "ds") < 0) return;
   string src = (part == "ds" ? "ds" : "pr");
   datetime ta = (datetime)ObjectGetInteger(0, base + src, OBJPROP_TIME, 0);
   datetime tb = (datetime)ObjectGetInteger(0, base + src, OBJPROP_TIME, 1);
   double pa = ObjectGetDouble(0, base + src, OBJPROP_PRICE, 0);
   double pb = ObjectGetDouble(0, base + src, OBJPROP_PRICE, 1);
   datetime tl = (ta < tb ? ta : tb), tr = (ta < tb ? tb : ta);
   double top = MathMax(pa, pb), bot = MathMin(pa, pb);
   double hi, lo;
   if(src == "pr") { hi = top; lo = 2.0 * bot - top; }
   else            { lo = bot; hi = 2.0 * top - bot; }
   PDSet(base, tl, tr, hi, lo);
}

void MakePD(string base, datetime t, double p)
{
   ObjectCreate(0, base + "pr", OBJ_RECTANGLE, 0, t, p, t, p);
   ObjectCreate(0, base + "ds", OBJ_RECTANGLE, 0, t, p, t, p);
   ObjectCreate(0, base + "md", OBJ_TREND, 0, t, p, t, p);
   ObjectCreate(0, base + "pm", OBJ_TEXT, 0, t, p);
   ObjectCreate(0, base + "dc", OBJ_TEXT, 0, t, p);
   ObjectCreate(0, base + "eq", OBJ_TEXT, 0, t, p);

   string pr = base + "pr", ds = base + "ds", md = base + "md", pm = base + "pm", dc = base + "dc", eq = base + "eq";
   ObjectSetInteger(0, pr, OBJPROP_COLOR, InpPremColor);
   ObjectSetInteger(0, ds, OBJPROP_COLOR, InpDiscColor);
   string rc[2];
   rc[0] = pr; rc[1] = ds;
   for(int i = 0; i < 2; i++)
   {
      ObjectSetInteger(0, rc[i], OBJPROP_FILL, true);
      ObjectSetInteger(0, rc[i], OBJPROP_BACK, true);
      ObjectSetInteger(0, rc[i], OBJPROP_SELECTABLE, true);
      ObjectSetInteger(0, rc[i], OBJPROP_SELECTED, false);
      ObjectSetInteger(0, rc[i], OBJPROP_HIDDEN, false);
   }
   ObjectSetInteger(0, md, OBJPROP_COLOR, InpEqColor);
   ObjectSetInteger(0, md, OBJPROP_STYLE, STYLE_DOT);
   ObjectSetInteger(0, md, OBJPROP_RAY_RIGHT, false);
   ObjectSetInteger(0, md, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, md, OBJPROP_HIDDEN, false);

   string tx[3];
   tx[0] = pm; tx[1] = dc; tx[2] = eq;
   for(int i = 0; i < 3; i++)
   {
      ObjectSetInteger(0, tx[i], OBJPROP_COLOR, InpEqColor);
      ObjectSetInteger(0, tx[i], OBJPROP_FONTSIZE, 8);
      ObjectSetInteger(0, tx[i], OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, tx[i], OBJPROP_HIDDEN, false);
   }
   ObjectSetString(0, pm, OBJPROP_TEXT, "Premium");
   ObjectSetString(0, dc, OBJPROP_TEXT, "Discount");
   ObjectSetString(0, eq, OBJPROP_TEXT, "Equilibrium 50%");
   ObjectSetInteger(0, pm, OBJPROP_ANCHOR, ANCHOR_RIGHT_UPPER);
   ObjectSetInteger(0, dc, OBJPROP_ANCHOR, ANCHOR_RIGHT_LOWER);
   ObjectSetInteger(0, eq, OBJPROP_ANCHOR, ANCHOR_RIGHT_LOWER);
}

//+------------------------------------------------------------------+
//| group: trend line with text (rotated label on the line)           |
//+------------------------------------------------------------------+
void RefreshTL(string base)
{
   if(ObjectFind(0, base + "ln") < 0 || ObjectFind(0, base + "lb") < 0) return;
   datetime t0 = (datetime)ObjectGetInteger(0, base + "ln", OBJPROP_TIME, 0);
   datetime t1 = (datetime)ObjectGetInteger(0, base + "ln", OBJPROP_TIME, 1);
   double p0 = ObjectGetDouble(0, base + "ln", OBJPROP_PRICE, 0);
   double p1 = ObjectGetDouble(0, base + "ln", OBJPROP_PRICE, 1);
   int x0, y0, x1, y1;
   if(!ChartTimePriceToXY(0, 0, t0, p0, x0, y0)) return;
   if(!ChartTimePriceToXY(0, 0, t1, p1, x1, y1)) return;

   double ang = MathArctan2((double)(y0 - y1), (double)(x1 - x0)) * 180.0 / M_PI;
   if(ang > 90.0)  ang -= 180.0;
   if(ang < -90.0) ang += 180.0;
   if(ang < 0.0)   ang += 360.0;
   ObjectSetDouble(0, base + "lb", OBJPROP_ANGLE, ang);

   datetime tm = (datetime)((long)t0 + ((long)t1 - (long)t0) / 2);
   ObjectMove(0, base + "lb", 0, tm, (p0 + p1) / 2.0);
}

void MakeTL(string base, bool ray, datetime t, double p)
{
   string ln = base + "ln", lb = base + "lb";
   ObjectCreate(0, ln, OBJ_TREND, 0, t, p, t, p);
   StyleObj(ln);
   ObjectSetInteger(0, ln, OBJPROP_RAY_RIGHT, ray);
   ObjectCreate(0, lb, OBJ_TEXT, 0, t, p);
   ObjectSetString(0, lb, OBJPROP_TEXT, "");
   ObjectSetInteger(0, lb, OBJPROP_COLOR, g_color);
   ObjectSetInteger(0, lb, OBJPROP_FONTSIZE, 9);
   ObjectSetInteger(0, lb, OBJPROP_ANCHOR, ANCHOR_CENTER);
   ObjectSetInteger(0, lb, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, lb, OBJPROP_HIDDEN, false);
}

//+------------------------------------------------------------------+
//| group: curved arrow (quadratic bezier made of segments)           |
//+------------------------------------------------------------------+
void CAPoint(int k, datetime &t, double &p)
{
   double u = (double)k / CA_N;
   double a = (1.0 - u) * (1.0 - u), b = 2.0 * u * (1.0 - u), c = u * u;
   double tt = a * (double)g_t0 + b * (double)g_tc + c * (double)g_t1;
   t = (datetime)(long)MathRound(tt);
   p = a * g_p0 + b * g_pc + c * g_p1;
}

void CAApply(string base, bool create)
{
   datetime ta, tb;
   double pa, pb;
   for(int k = 0; k < CA_N; k++)
   {
      CAPoint(k, ta, pa);
      CAPoint(k + 1, tb, pb);
      string nm = base + StringFormat("%02d", k);
      if(create)
      {
         ObjectCreate(0, nm, OBJ_TREND, 0, ta, pa, tb, pb);
         StyleObj(nm);
         ObjectSetInteger(0, nm, OBJPROP_RAY_RIGHT, false);
         ObjectSetInteger(0, nm, OBJPROP_SELECTABLE, k == 0);
      }
      else
      {
         ObjectMove(0, nm, 0, ta, pa);
         ObjectMove(0, nm, 1, tb, pb);
      }
   }

   // arrow head at the end point
   datetime tN, tM;
   double pN, pM;
   CAPoint(CA_N, tN, pN);
   CAPoint(CA_N - 1, tM, pM);
   int ex, ey, mx, my;
   bool okHead = ChartTimePriceToXY(0, 0, tN, pN, ex, ey) && ChartTimePriceToXY(0, 0, tM, pM, mx, my);
   double ux = 0, uy = 0;
   if(okHead)
   {
      double dx = ex - mx, dy = ey - my;
      double len = MathSqrt(dx * dx + dy * dy);
      if(len < 0.5) okHead = false;
      else { ux = dx / len; uy = dy / len; }
   }
   for(int w = 0; w < 2; w++)
   {
      string hn = base + (w == 0 ? "90" : "91");
      datetime tw = tN;
      double pw = pN;
      if(okHead)
      {
         double ang = (w == 0 ? 0.45 : -0.45);   // about 26 degrees
         double rx = ux * MathCos(ang) - uy * MathSin(ang);
         double ry = ux * MathSin(ang) + uy * MathCos(ang);
         int wx = (int)MathRound(ex - 14.0 * rx), wy = (int)MathRound(ey - 14.0 * ry);
         int sub;
         datetime t2;
         double p2;
         if(ChartXYToTimePrice(0, wx, wy, sub, t2, p2)) { tw = t2; pw = p2; }
      }
      if(create)
      {
         ObjectCreate(0, hn, OBJ_TREND, 0, tN, pN, tw, pw);
         StyleObj(hn);
         ObjectSetInteger(0, hn, OBJPROP_RAY_RIGHT, false);
         ObjectSetInteger(0, hn, OBJPROP_SELECTABLE, false);
      }
      else
      {
         ObjectMove(0, hn, 0, tN, pN);
         ObjectMove(0, hn, 1, tw, pw);
      }
   }
}

//+------------------------------------------------------------------+
//| point snapping (time to bar, price to OHLC with magnet)           |
//+------------------------------------------------------------------+
bool SnapPoint(int x, int y, bool magnet, datetime &t, double &p)
{
   int sub = 0;
   datetime tt;
   double pp;
   if(!ChartXYToTimePrice(0, x, y, sub, tt, pp) || sub != 0) return false;

   int ps = PeriodSeconds();
   datetime t0 = iTime(_Symbol, _Period, 0);
   t = tt;
   p = pp;
   if(tt > t0 + ps) return true;

   int sh = iBarShift(_Symbol, _Period, tt, false);
   if(sh < 0) return true;
   t = iTime(_Symbol, _Period, sh);

   if(magnet || g_magnet)
   {
      double cand[4];
      cand[0] = iOpen(_Symbol, _Period, sh);
      cand[1] = iHigh(_Symbol, _Period, sh);
      cand[2] = iLow(_Symbol, _Period, sh);
      cand[3] = iClose(_Symbol, _Period, sh);
      double best = 1e18;
      int bi = -1;
      for(int i = 0; i < 4; i++)
      {
         int cx, cy;
         if(!ChartTimePriceToXY(0, 0, t, cand[i], cx, cy)) continue;
         double d = MathAbs(cy - y);
         if(d < best) { best = d; bi = i; }
      }
      if(bi >= 0 && best <= 30) p = cand[bi];
   }
   return true;
}

//+------------------------------------------------------------------+
//| hit testing for one-click selection                               |
//+------------------------------------------------------------------+
double SegDist(double px, double py, double x1, double y1, double x2, double y2, bool ray)
{
   double dx = x2 - x1, dy = y2 - y1;
   double len2 = dx * dx + dy * dy;
   double u = 0;
   if(len2 > 0) u = ((px - x1) * dx + (py - y1) * dy) / len2;
   if(u < 0) u = 0;
   if(!ray && u > 1) u = 1;
   double cx = x1 + u * dx, cy = y1 + u * dy;
   return MathSqrt((px - cx) * (px - cx) + (py - cy) * (py - cy));
}

double DistTo(string name, int x, int y)
{
   long type = ObjectGetInteger(0, name, OBJPROP_TYPE);
   datetime tref = iTime(_Symbol, _Period, 0);
   int x1 = 0, y1 = 0, x2 = 0, y2 = 0;

   if(type == OBJ_HLINE)
   {
      double pr = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      if(!ChartTimePriceToXY(0, 0, tref, pr, x1, y1)) return 1e9;
      return MathAbs(y - y1);
   }
   if(type == OBJ_ARROW_UP || type == OBJ_ARROW_DOWN || type == OBJ_TEXT)
   {
      datetime t = (datetime)ObjectGetInteger(0, name, OBJPROP_TIME, 0);
      double pr = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      if(!ChartTimePriceToXY(0, 0, t, pr, x1, y1)) return 1e9;
      double d = MathSqrt((double)((x - x1) * (x - x1) + (y - y1) * (y - y1)));
      return (type == OBJ_TEXT ? MathMax(0.0, d - 20.0) : MathMax(0.0, d - 8.0));
   }
   if(type == OBJ_TREND || type == OBJ_RECTANGLE || type == OBJ_FIBO)
   {
      datetime ta = (datetime)ObjectGetInteger(0, name, OBJPROP_TIME, 0);
      datetime tb = (datetime)ObjectGetInteger(0, name, OBJPROP_TIME, 1);
      double pa = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
      double pb = ObjectGetDouble(0, name, OBJPROP_PRICE, 1);
      if(!ChartTimePriceToXY(0, 0, ta, pa, x1, y1)) return 1e9;
      if(!ChartTimePriceToXY(0, 0, tb, pb, x2, y2)) return 1e9;

      if(type == OBJ_TREND)
      {
         bool ray = (ObjectGetInteger(0, name, OBJPROP_RAY_RIGHT) != 0);
         return SegDist(x, y, x1, y1, x2, y2, ray);
      }
      int minx = MathMin(x1, x2), maxx = MathMax(x1, x2);
      int miny = MathMin(y1, y2), maxy = MathMax(y1, y2);
      bool inside = (x >= minx && x <= maxx && y >= miny && y <= maxy);
      bool filled = (type == OBJ_FIBO) || (ObjectGetInteger(0, name, OBJPROP_FILL) != 0);
      if(inside)
      {
         if(filled) return 0.0;
         return (double)MathMin(MathMin(x - minx, maxx - x), MathMin(y - miny, maxy - y));
      }
      double dx = MathMax(MathMax(minx - x, 0), x - maxx);
      double dy = MathMax(MathMax(miny - y, 0), y - maxy);
      return MathSqrt(dx * dx + dy * dy);
   }
   return 1e9;
}

string HitTest(int x, int y)
{
   string best = "";
   double bd = 8.0;
   for(int i = 0; i < ObjectsTotal(0); i++)
   {
      string name = ObjectName(0, i);
      if(!IsDR(name)) continue;
      if(!ObjectGetInteger(0, name, OBJPROP_SELECTABLE)) continue;
      double d;
      if(InKind(name, "_GC_"))
      {
         // curved arrow: only the first segment is selectable; measure against the whole curve
         string base = GroupBase(name);
         string mem[];
         Members(base, mem);
         d = 1e9;
         for(int k = 0; k < ArraySize(mem); k++)
            d = MathMin(d, DistTo(mem[k], x, y));
      }
      else
         d = DistTo(name, x, y);
      if(d < bd) { bd = d; best = name; }
   }
   return best;
}

//+------------------------------------------------------------------+
//| selection helpers and apply actions                               |
//+------------------------------------------------------------------+
int GetSelected(string &out[])
{
   ArrayResize(out, 0);
   if(g_useOverride)
   {
      for(int i = 0; i < ArraySize(g_ovr); i++) Push(out, g_ovr[i]);
      return ArraySize(out);
   }
   for(int i = 0; i < ObjectsTotal(0); i++)
   {
      string nm = ObjectName(0, i);
      if(!IsDR(nm)) continue;
      if(ObjectGetInteger(0, nm, OBJPROP_SELECTED) == 0) continue;
      Push(out, nm);
   }
   return ArraySize(out);
}

bool InList(string &arr[], string v)
{
   for(int i = 0; i < ArraySize(arr); i++) if(arr[i] == v) return true;
   return false;
}

// objects whose color / width / style the edit bar changes
void StyleTargets(string &out[])
{
   ArrayResize(out, 0);
   string sel[], seen[];
   GetSelected(sel);
   for(int i = 0; i < ArraySize(sel); i++)
   {
      string nm = sel[i];
      if(!IsGrp(nm)) { Push(out, nm); continue; }
      string base = GroupBase(nm);
      if(InList(seen, base)) continue;
      Push(seen, base);
      if(InKind(nm, "_GT_")) { Push(out, base + "ln"); Push(out, base + "lb"); }
      else if(InKind(nm, "_GC_"))
      {
         string mem[];
         Members(base, mem);
         for(int k = 0; k < ArraySize(mem); k++) Push(out, mem[k]);
      }
   }
}

// every object of the selection including whole groups (lock, timeframe, delete)
void AllTargets(string &out[])
{
   ArrayResize(out, 0);
   string sel[], seen[];
   GetSelected(sel);
   for(int i = 0; i < ArraySize(sel); i++)
   {
      string nm = sel[i];
      if(!IsGrp(nm)) { Push(out, nm); continue; }
      string base = GroupBase(nm);
      if(InList(seen, base)) continue;
      Push(seen, base);
      string mem[];
      Members(base, mem);
      for(int k = 0; k < ArraySize(mem); k++) Push(out, mem[k]);
   }
}

void DeleteGroupOrObj(string name)
{
   if(IsGrp(name)) DeleteBase(GroupBase(name));
   else ObjectDelete(0, name);
}

void DeleteSelected()
{
   string sel[];
   GetSelected(sel);
   for(int i = 0; i < ArraySize(sel); i++)
      DeleteGroupOrObj(sel[i]);
   PushSnap();
   UpdateFB(true);
   ChartRedraw(0);
}

void ApplyColor(color c)
{
   g_color = c;
   string t[];
   StyleTargets(t);
   for(int i = 0; i < ArraySize(t); i++)
   {
      ObjectSetInteger(0, t[i], OBJPROP_COLOR, c);
      if(ObjectGetInteger(0, t[i], OBJPROP_TYPE) == OBJ_FIBO) SetupFibo(t[i], c);
   }
   PushSnap();
   UpdateButtons();
   UpdateFB(true);
}

void ApplyWidth(int w)
{
   g_width = w;
   string t[];
   StyleTargets(t);
   for(int i = 0; i < ArraySize(t); i++) ObjectSetInteger(0, t[i], OBJPROP_WIDTH, w);
   PushSnap();
   UpdateButtons();
   UpdateFB(true);
}

void ApplyStyle(int s)
{
   g_style = s;
   string t[];
   StyleTargets(t);
   for(int i = 0; i < ArraySize(t); i++) ObjectSetInteger(0, t[i], OBJPROP_STYLE, s);
   PushSnap();
   UpdateButtons();
   UpdateFB(true);
}

void ApplyFill()
{
   string sel[];
   GetSelected(sel);
   for(int i = 0; i < ArraySize(sel); i++)
   {
      if(IsGrp(sel[i])) continue;
      if(ObjectGetInteger(0, sel[i], OBJPROP_TYPE) != OBJ_RECTANGLE) continue;
      bool f = (ObjectGetInteger(0, sel[i], OBJPROP_FILL) != 0);
      ObjectSetInteger(0, sel[i], OBJPROP_FILL, !f);
      ObjectSetInteger(0, sel[i], OBJPROP_BACK, !f);
   }
   PushSnap();
   ChartRedraw(0);
}

void ApplyLock()
{
   string t[];
   AllTargets(t);
   for(int i = 0; i < ArraySize(t); i++)
   {
      ObjectSetInteger(0, t[i], OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, t[i], OBJPROP_SELECTED, false);
   }
   PushSnap();
   UpdateFB(true);
}

bool DefaultSelectable(string name)
{
   if(InKind(name, "_GC_"))  return Suffix(name) == "00";
   if(InKind(name, "_PD_"))  return (Suffix(name) == "pr" || Suffix(name) == "ds");
   if(InKind(name, "_GT_"))  return Suffix(name) == "ln";
   if(InKind(name, "_LS_"))  return Suffix(name) != "lb";
   return true;
}

void UnlockAll()
{
   for(int i = 0; i < ObjectsTotal(0); i++)
   {
      string name = ObjectName(0, i);
      if(IsDR(name)) ObjectSetInteger(0, name, OBJPROP_SELECTABLE, DefaultSelectable(name));
   }
   PushSnap();
   ChartRedraw(0);
}

void ApplyTF()
{
   string t[];
   AllTargets(t);
   for(int i = 0; i < ArraySize(t); i++)
   {
      long cur = ObjectGetInteger(0, t[i], OBJPROP_TIMEFRAMES);
      ObjectSetInteger(0, t[i], OBJPROP_TIMEFRAMES, cur == OBJ_ALL_PERIODS ? TfFlag() : OBJ_ALL_PERIODS);
   }
   PushSnap();
   ChartRedraw(0);
}

void ClearAll()
{
   DeleteAllDR();
   PushSnap();
   UpdateFB(true);
   ChartRedraw(0);
}

// text typed in the edit bar
void ApplyText(string txt)
{
   string sel[];
   GetSelected(sel);
   for(int i = 0; i < ArraySize(sel); i++)
   {
      string nm = sel[i];
      if(InKind(nm, "_GT_"))
      {
         string base = GroupBase(nm);
         ObjectSetString(0, base + "lb", OBJPROP_TEXT, txt);
         RefreshTL(base);
      }
      else if(!IsGrp(nm) && ObjectGetInteger(0, nm, OBJPROP_TYPE) == OBJ_TEXT)
         ObjectSetString(0, nm, OBJPROP_TEXT, txt);
   }
   PushSnap();
   ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| export / import                                                   |
//+------------------------------------------------------------------+
string DrawFileName() { return "DrawPanelPro_" + _Symbol + ".txt"; }

void ExportDrawings()
{
   int h = FileOpen(DrawFileName(), FILE_WRITE | FILE_TXT | FILE_ANSI);
   if(h == INVALID_HANDLE) { Print("DrawPanelPro: export failed"); return; }
   FileWriteString(h, Snapshot());
   FileClose(h);
   Print("DrawPanelPro: drawings exported to MQL5/Files/", DrawFileName());
}

void ImportDrawings()
{
   int h = FileOpen(DrawFileName(), FILE_READ | FILE_TXT | FILE_ANSI);
   if(h == INVALID_HANDLE) { Print("DrawPanelPro: file not found: MQL5/Files/", DrawFileName()); return; }
   string s = FileReadString(h);
   FileClose(h);
   Restore(s);
   SeedId();
   PushSnap();
   UpdateFB(true);
   Print("DrawPanelPro: drawings imported (current drawings were replaced; Ctrl+Z to undo)");
}

//+------------------------------------------------------------------+
//| floating edit bar                                                 |
//+------------------------------------------------------------------+
void HideFB()
{
   g_fbShown = false;
   g_fbSig = "";
   string ids[] = {"fb_bg", "fb_col", "fb_wid", "fb_sty", "fb_txt", "fb_fill", "fb_tf", "fb_lock", "fb_del"};
   for(int i = 0; i < ArraySize(ids); i++) ShowUI(ids[i], false);
}

bool BoundsOf(string name, int &x0, int &y0, int &x1, int &y1)
{
   long type = ObjectGetInteger(0, name, OBJPROP_TYPE);
   int W = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   datetime tref = iTime(_Symbol, _Period, 0);
   int xa, ya, xb, yb;

   if(type == OBJ_HLINE)
   {
      if(!ChartTimePriceToXY(0, 0, tref, ObjectGetDouble(0, name, OBJPROP_PRICE, 0), xa, ya)) return false;
      x0 = 0; x1 = W; y0 = ya; y1 = ya;
      return true;
   }
   int an = Anchors(type);
   if(an == 0) return false;
   datetime ta = (datetime)ObjectGetInteger(0, name, OBJPROP_TIME, 0);
   double pa = ObjectGetDouble(0, name, OBJPROP_PRICE, 0);
   if(!ChartTimePriceToXY(0, 0, ta, pa, xa, ya)) return false;
   x0 = xa; x1 = xa; y0 = ya; y1 = ya;
   if(an == 2)
   {
      datetime tb = (datetime)ObjectGetInteger(0, name, OBJPROP_TIME, 1);
      double pb = ObjectGetDouble(0, name, OBJPROP_PRICE, 1);
      if(ChartTimePriceToXY(0, 0, tb, pb, xb, yb))
      {
         x0 = MathMin(xa, xb); x1 = MathMax(xa, xb);
         y0 = MathMin(ya, yb); y1 = MathMax(ya, yb);
      }
   }
   return true;
}

void UpdateFB(bool force)
{
   string sel[];
   if(GetSelected(sel) == 0) { if(g_fbShown) { HideFB(); PalHide(); ChartRedraw(0); } return; }

   // bounding box of the selection (whole groups)
   int minx = 1 << 30, miny = 1 << 30, maxx = -1, maxy = -1;
   bool anyText = false, anyRect = false;
   string names = "";
   string seen[];
   for(int i = 0; i < ArraySize(sel); i++)
   {
      string nm = sel[i];
      names += nm + ";";
      string list[];
      if(IsGrp(nm))
      {
         string base = GroupBase(nm);
         if(InList(seen, base)) continue;
         Push(seen, base);
         Members(base, list);
         if(InKind(nm, "_GT_")) anyText = true;
      }
      else
      {
         Push(list, nm);
         long ty = ObjectGetInteger(0, nm, OBJPROP_TYPE);
         if(ty == OBJ_TEXT) anyText = true;
         if(ty == OBJ_RECTANGLE) anyRect = true;
      }
      for(int k = 0; k < ArraySize(list); k++)
      {
         int a, b, c, d;
         if(!BoundsOf(list[k], a, b, c, d)) continue;
         minx = MathMin(minx, a); miny = MathMin(miny, b);
         maxx = MathMax(maxx, c); maxy = MathMax(maxy, d);
      }
   }
   if(maxx < 0) return;

   int W = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int fx = (minx + maxx) / 2 - FBW / 2;
   fx = MathMax(4, MathMin(W - FBW - 4, fx));
   int fy = miny - FBH - 12;
   if(fy < 4) fy = maxy + 12;
   if(g_tbY > (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS) / 2 && fy + FBH > g_tbY - 4) fy = g_tbY - FBH - 4;
   if(fy < 4) fy = 4;

   string sig = names + IntegerToString(fx) + "," + IntegerToString(fy);
   if(!force && g_fbShown && sig == g_fbSig) return;
   g_fbSig = sig;
   g_fbShown = true;
   g_fbX = fx;
   g_fbY = fy;

   ObjectSetInteger(0, UI + "fb_bg", OBJPROP_XDISTANCE, fx);
   ObjectSetInteger(0, UI + "fb_bg", OBJPROP_YDISTANCE, fy);
   ObjectSetInteger(0, UI + "fb_bg", OBJPROP_XSIZE, FBW);
   ObjectSetInteger(0, UI + "fb_bg", OBJPROP_YSIZE, FBH);
   PlaceUI("fb_col",  fx + 4,   fy + 3);
   PlaceUI("fb_wid",  fx + 34,  fy + 3);
   PlaceUI("fb_sty",  fx + 80,  fy + 3);
   PlaceUI("fb_txt",  fx + 110, fy + 3);
   PlaceUI("fb_fill", fx + 204, fy + 3);
   PlaceUI("fb_tf",   fx + 234, fy + 3);
   PlaceUI("fb_lock", fx + 264, fy + 3);
   PlaceUI("fb_del",  fx + 300, fy + 3);

   // reflect the first selected object
   string first = sel[0];
   string st[3];
   st[0] = Sym(0x2501); st[1] = Sym(0x254D); st[2] = Sym(0x2505);
   string ref = first;
   if(InKind(first, "_GT_")) ref = GroupBase(first) + "ln";
   ObjectSetInteger(0, UI + "fb_col", OBJPROP_COLOR, (color)ObjectGetInteger(0, ref, OBJPROP_COLOR));
   ObjectSetString(0, UI + "fb_wid", OBJPROP_TEXT, IntegerToString(ObjectGetInteger(0, ref, OBJPROP_WIDTH)) + "px");
   int sty = (int)ObjectGetInteger(0, ref, OBJPROP_STYLE);
   ObjectSetString(0, UI + "fb_sty", OBJPROP_TEXT, st[sty % 3]);

   if(anyText)
   {
      string cur = "";
      if(InKind(first, "_GT_")) cur = ObjectGetString(0, GroupBase(first) + "lb", OBJPROP_TEXT);
      else if(!IsGrp(first)) cur = ObjectGetString(0, first, OBJPROP_TEXT);
      ObjectSetString(0, UI + "fb_txt", OBJPROP_TEXT, cur);
   }

   ShowUI("fb_bg", true);
   ShowUI("fb_col", true);
   ShowUI("fb_wid", true);
   ShowUI("fb_sty", true);
   ShowUI("fb_txt", anyText);
   ShowUI("fb_fill", anyRect);
   ShowUI("fb_tf", true);
   ShowUI("fb_lock", true);
   ShowUI("fb_del", true);
   ChartRedraw(0);
}

//+------------------------------------------------------------------+
//| objects list panel                                                |
//+------------------------------------------------------------------+
string TfName() { return StringSubstr(EnumToString(_Period), 7); }

void ApplyTFSet(bool only)
{
   string t[];
   AllTargets(t);
   for(int i = 0; i < ArraySize(t); i++)
      ObjectSetInteger(0, t[i], OBJPROP_TIMEFRAMES, only ? TfFlag() : OBJ_ALL_PERIODS);
   PushSnap();
   ChartRedraw(0);
}

void ApplyStyleAll()
{
   string t[];
   StyleTargets(t);
   for(int i = 0; i < ArraySize(t); i++)
   {
      ObjectSetInteger(0, t[i], OBJPROP_COLOR, g_color);
      ObjectSetInteger(0, t[i], OBJPROP_WIDTH, g_width);
      ObjectSetInteger(0, t[i], OBJPROP_STYLE, g_style);
      if(ObjectGetInteger(0, t[i], OBJPROP_TYPE) == OBJ_FIBO) SetupFibo(t[i], g_color);
   }
   PushSnap();
   ChartRedraw(0);
}

string GroupRep(string base)
{
   string r = base;
   if(InKind(base, "_LS_"))      r = base + "tp";
   else if(InKind(base, "_PD_")) r = base + "pr";
   else if(InKind(base, "_GT_")) r = base + "ln";
   else if(InKind(base, "_GC_")) r = base + "00";
   return r;
}

void BuildEntries(string &ent[])
{
   ArrayResize(ent, 0);
   string seen[];
   for(int i = 0; i < ObjectsTotal(0); i++)
   {
      string nm = ObjectName(0, i);
      if(!IsDR(nm)) continue;
      if(IsGrp(nm))
      {
         string base = GroupBase(nm);
         if(InList(seen, base)) continue;
         Push(seen, base);
         string rep = GroupRep(base);
         Push(ent, ObjectFind(0, rep) >= 0 ? rep : nm);
      }
      else
         Push(ent, nm);
   }
}

string EntryTitle(string rep)
{
   if(InKind(rep, "_LS_"))
   {
      string tx = ObjectGetString(0, GroupBase(rep) + "lb", OBJPROP_TEXT);
      return (StringFind(tx, "LONG") == 0 ? "Long position" : "Short position");
   }
   if(InKind(rep, "_PD_")) return "Premium / Discount";
   if(InKind(rep, "_GC_")) return "Curved arrow";
   if(InKind(rep, "_GT_"))
   {
      string b = GroupBase(rep);
      string s = (ObjectGetInteger(0, b + "ln", OBJPROP_RAY_RIGHT) != 0 ? "Ray" : "Trend line");
      string tx = ObjectGetString(0, b + "lb", OBJPROP_TEXT);
      if(tx != "") s += " " + tx;
      return s;
   }
   long ty = ObjectGetInteger(0, rep, OBJPROP_TYPE);
   if(ty == OBJ_HLINE)       return "Horizontal line";
   if(ty == OBJ_RECTANGLE)   return "Box";
   if(ty == OBJ_FIBO)        return (InKind(rep, "_FX_") ? "Fib extension" : "Fib retracement");
   if(ty == OBJ_ARROW_UP)    return "Arrow up";
   if(ty == OBJ_ARROW_DOWN)  return "Arrow down";
   if(ty == OBJ_TEXT)        return "Text: " + ObjectGetString(0, rep, OBJPROP_TEXT);
   if(ty == OBJ_TREND)       return (ObjectGetInteger(0, rep, OBJPROP_RAY_RIGHT) != 0 ? "Ray" : "Trend line");
   return "Object";
}

void LsAdd(string id) { Push(g_lsIds, id); }

void MkLabelUI(string id, string text, color c, int fs)
{
   string name = UI + id;
   if(ObjectFind(0, name) < 0) ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0);
   ObjectSetString(0, name, OBJPROP_TEXT, text);
   ObjectSetString(0, name, OBJPROP_FONT, FONT_UI);
   ObjectSetInteger(0, name, OBJPROP_COLOR, c);
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, fs);
   ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
   LsAdd(id);
}

void MkBtnLs(string id, string text, int w, int h, color bg, color fg, string tip)
{
   MakeBtn(id, text, w, h, bg, fg, tip, 8);
   LsAdd(id);
}

void CreateList()
{
   ArrayResize(g_lsIds, 0);
   MakeRectUI("ls_bg", C'20,22,32');
   LsAdd("ls_bg");
   MkLabelUI("ls_title", "OBJECTS", clrWhite, 9);
   MkBtnLs("ls_close", "x", 20, 18, C'30,30,46', clrTomato, "Close");
   MkLabelUI("ls_hint", "", clrGray, 7);
   MkBtnLs("ls_auto", "", LSW - 16, 22, C'30,40,90', clrWhite, "Convert native MT5 drawings (default names) to panel style");
   MkLabelUI("ls_sel", "SELECTED: 0", clrWhite, 8);
   MkBtnLs("ls_only", "Only", 158, 22, C'30,40,90', clrWhite, "Show selected only on this timeframe");
   MkBtnLs("ls_alltf", "All TFs", 158, 22, C'40,40,56', clrWhite, "Show selected on all timeframes");
   MkBtnLs("ls_style", "Apply line style", 104, 22, C'40,40,56', clrWhite, "Apply current color / width / style to the selected");
   MkBtnLs("ls_delsel", "Delete selected", 104, 22, C'40,40,56', clrTomato, "Delete the selected");
   MkBtnLs("ls_clrsel", "Clear selection", 108, 22, C'40,40,56', clrWhite, "Clear selection");

   for(int r = 0; r < InpListRows; r++)
   {
      string k = IntegerToString(r);
      MkBtnLs("ls_c" + k, "", 20, 20, C'40,40,56', clrWhite, "Select");
      MakeRectUI("ls_k" + k, clrDodgerBlue);
      LsAdd("ls_k" + k);
      MkBtnLs("ls_n" + k, "", 148, 20, C'30,32,46', clrWhite, "Click to select on chart");
      MkBtnLs("ls_t" + k, "", 46, 20, C'40,40,56', clrWhite, "Only on this timeframe");
      MkBtnLs("ls_a" + k, "All TFs", 60, 20, C'40,40,56', clrWhite, "All timeframes");
      MkBtnLs("ls_x" + k, "x", 22, 20, C'30,32,46', clrTomato, "Delete");
   }

   MkBtnLs("ls_prev", "<", 26, 22, C'40,40,56', clrWhite, "Previous page");
   MkBtnLs("ls_next", ">", 26, 22, C'40,40,56', clrWhite, "Next page");
   MkLabelUI("ls_page", "Page 1 / 1", clrSilver, 8);
   MkBtnLs("ls_all", "All", 34, 22, C'40,40,56', clrWhite, "Select all");
   MkBtnLs("ls_none", "None", 44, 22, C'40,40,56', clrWhite, "Select none");
   MkBtnLs("ls_showall", "Show all on all TFs", 108, 22, C'40,40,56', clrWhite, "Make every drawing visible on all timeframes");
   ShowList(false);
}

void LayoutList()
{
   int W = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int rows = InpListRows;
   g_lsH = 138 + rows * 24 + 6 + 22 + 8;
   g_lsX = MathMax(4, W - LSW - InpListRight);
   g_lsY = 30;
   int x = g_lsX, y = g_lsY;

   ObjectSetInteger(0, UI + "ls_bg", OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, UI + "ls_bg", OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, UI + "ls_bg", OBJPROP_XSIZE, LSW);
   ObjectSetInteger(0, UI + "ls_bg", OBJPROP_YSIZE, g_lsH);

   PlaceUI("ls_title", x + 10, y + 7);
   PlaceUI("ls_close", x + LSW - 28, y + 5);
   PlaceUI("ls_hint",  x + 10, y + 27);
   PlaceUI("ls_auto",  x + 8,  y + 40);
   PlaceUI("ls_sel",   x + 10, y + 68);
   PlaceUI("ls_only",  x + 8,   y + 84);
   PlaceUI("ls_alltf", x + 174, y + 84);
   PlaceUI("ls_style",  x + 8,   y + 110);
   PlaceUI("ls_delsel", x + 116, y + 110);
   PlaceUI("ls_clrsel", x + 224, y + 110);

   for(int r = 0; r < rows; r++)
   {
      string k = IntegerToString(r);
      int ry = y + 138 + r * 24;
      PlaceUI("ls_c" + k, x + 8, ry);
      PlaceUI("ls_k" + k, x + 32, ry);
      ObjectSetInteger(0, UI + "ls_k" + k, OBJPROP_XSIZE, 6);
      ObjectSetInteger(0, UI + "ls_k" + k, OBJPROP_YSIZE, 20);
      PlaceUI("ls_n" + k, x + 42, ry);
      PlaceUI("ls_t" + k, x + 194, ry);
      PlaceUI("ls_a" + k, x + 244, ry);
      PlaceUI("ls_x" + k, x + 308, ry);
   }
   int fy = y + 138 + rows * 24 + 6;
   PlaceUI("ls_prev", x + 8, fy);
   PlaceUI("ls_next", x + 36, fy);
   PlaceUI("ls_page", x + 68, fy + 4);
   PlaceUI("ls_all", x + 138, fy);
   PlaceUI("ls_none", x + 176, fy);
   PlaceUI("ls_showall", x + 224, fy);
}

void ShowList(bool show)
{
   for(int i = 0; i < ArraySize(g_lsIds); i++) ShowUI(g_lsIds[i], show);
}

string ListSig(string &ent[])
{
   string sig = IntegerToString(ArraySize(ent)) + "|" + IntegerToString(g_lsPage) + "|" + TfName() + "|";
   for(int i = 0; i < ArraySize(ent); i++)
      sig += ent[i] + ":" + IntegerToString(ObjectGetInteger(0, ent[i], OBJPROP_TIMEFRAMES)) + ":" +
             IntegerToString(ObjectGetInteger(0, ent[i], OBJPROP_COLOR)) + ":" + EntryTitle(ent[i]) + ";";
   return sig;
}

void RefreshList()
{
   if(!g_lsOpen) return;
   string ent[];
   BuildEntries(ent);
   int n = ArraySize(ent);
   int rows = InpListRows;
   int pages = MathMax(1, (n + rows - 1) / rows);
   if(g_lsPage >= pages) g_lsPage = pages - 1;
   if(g_lsPage < 0) g_lsPage = 0;

   // drop selections whose object no longer exists
   string keep[];
   for(int i = 0; i < ArraySize(g_lsSel); i++)
      if(InList(ent, g_lsSel[i])) Push(keep, g_lsSel[i]);
   ArrayResize(g_lsSel, 0);
   for(int i = 0; i < ArraySize(keep); i++) Push(g_lsSel, keep[i]);

   ObjectSetString(0, UI + "ls_title", OBJPROP_TEXT, "OBJECTS  (" + IntegerToString(n) + ")");
   ObjectSetString(0, UI + "ls_hint", OBJPROP_TEXT, "Chart: " + TfName() + "    Tick a row to select");
   ObjectSetString(0, UI + "ls_auto", OBJPROP_TEXT, "Auto-convert new MT5 drawings to panel style: " + (g_lsAuto ? "ON" : "OFF"));
   ObjectSetInteger(0, UI + "ls_auto", OBJPROP_BGCOLOR, g_lsAuto ? C'30,50,120' : C'40,40,56');
   ObjectSetString(0, UI + "ls_sel", OBJPROP_TEXT, "SELECTED: " + IntegerToString(ArraySize(g_lsSel)));
   ObjectSetString(0, UI + "ls_only", OBJPROP_TEXT, "Only " + TfName());
   ObjectSetString(0, UI + "ls_page", OBJPROP_TEXT, "Page " + IntegerToString(g_lsPage + 1) + " / " + IntegerToString(pages));

   for(int r = 0; r < rows; r++)
   {
      string k = IntegerToString(r);
      int idx = g_lsPage * rows + r;
      bool vis = (idx < n);
      string ids[] = {"ls_c", "ls_k", "ls_n", "ls_t", "ls_a", "ls_x"};
      for(int j = 0; j < ArraySize(ids); j++) ShowUI(ids[j] + k, vis);
      if(!vis) continue;

      string rep = ent[idx];
      bool sel = InList(g_lsSel, rep);
      long tfv = ObjectGetInteger(0, rep, OBJPROP_TIMEFRAMES);
      ObjectSetString(0, UI + "ls_c" + k, OBJPROP_TEXT, sel ? Sym(0x2713) : "");
      ObjectSetInteger(0, UI + "ls_c" + k, OBJPROP_BGCOLOR, sel ? C'30,80,220' : C'40,40,56');
      ObjectSetInteger(0, UI + "ls_k" + k, OBJPROP_BGCOLOR, (color)ObjectGetInteger(0, rep, OBJPROP_COLOR));
      ObjectSetString(0, UI + "ls_n" + k, OBJPROP_TEXT, EntryTitle(rep));
      ObjectSetString(0, UI + "ls_t" + k, OBJPROP_TEXT, TfName());
      ObjectSetInteger(0, UI + "ls_t" + k, OBJPROP_BGCOLOR, (tfv == TfFlag()) ? C'30,80,220' : C'40,40,56');
      ObjectSetInteger(0, UI + "ls_a" + k, OBJPROP_BGCOLOR, (tfv == OBJ_ALL_PERIODS) ? C'30,80,220' : C'40,40,56');
   }
   g_lsSig = ListSig(ent);
   ChartRedraw(0);
}

void ListTick()
{
   string ent[];
   BuildEntries(ent);
   if(ListSig(ent) != g_lsSig) RefreshList();
}

void ToggleList()
{
   g_lsOpen = !g_lsOpen;
   if(g_lsOpen)
   {
      LayoutList();
      ShowList(true);
      RefreshList();
   }
   else
      ShowList(false);
   UpdateButtons();
}

void ListApplyTo(string &targets[], int action)
{
   if(ArraySize(targets) == 0) return;
   ArrayResize(g_ovr, 0);
   for(int i = 0; i < ArraySize(targets); i++) Push(g_ovr, targets[i]);
   g_useOverride = true;
   if(action == 0)      ApplyTFSet(true);
   else if(action == 1) ApplyTFSet(false);
   else if(action == 2) ApplyStyleAll();
   else if(action == 3) DeleteSelected();
   g_useOverride = false;
   UpdateFB(true);
   RefreshList();
}

void HandleList(string id)
{
   int rows = InpListRows;
   if(id == "ls_close")        { g_lsOpen = true; ToggleList(); return; }
   if(id == "ls_auto")         { g_lsAuto = !g_lsAuto; RefreshList(); return; }
   if(id == "ls_only")         { ListApplyTo(g_lsSel, 0); return; }
   if(id == "ls_alltf")        { ListApplyTo(g_lsSel, 1); return; }
   if(id == "ls_style")        { ListApplyTo(g_lsSel, 2); return; }
   if(id == "ls_delsel")       { ListApplyTo(g_lsSel, 3); ArrayResize(g_lsSel, 0); RefreshList(); return; }
   if(id == "ls_clrsel")       { ArrayResize(g_lsSel, 0); RefreshList(); return; }
   if(id == "ls_prev")         { g_lsPage--; RefreshList(); return; }
   if(id == "ls_next")         { g_lsPage++; RefreshList(); return; }
   if(id == "ls_none")         { ArrayResize(g_lsSel, 0); RefreshList(); return; }
   if(id == "ls_all")
   {
      string ent[];
      BuildEntries(ent);
      ArrayResize(g_lsSel, 0);
      for(int i = 0; i < ArraySize(ent); i++) Push(g_lsSel, ent[i]);
      RefreshList();
      return;
   }
   if(id == "ls_showall")
   {
      for(int i = 0; i < ObjectsTotal(0); i++)
      {
         string nm = ObjectName(0, i);
         if(IsDR(nm)) ObjectSetInteger(0, nm, OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
      }
      PushSnap();
      RefreshList();
      return;
   }

   // row buttons: ls_c<i> ls_n<i> ls_t<i> ls_a<i> ls_x<i>
   if(StringLen(id) < 5) return;
   string kind = StringSubstr(id, 3, 1);
   int r = (int)StringToInteger(StringSubstr(id, 4));
   if(r < 0 || r >= rows) return;
   string ent2[];
   BuildEntries(ent2);
   int idx = g_lsPage * rows + r;
   if(idx >= ArraySize(ent2)) return;
   string rep = ent2[idx];
   string one[];
   Push(one, rep);

   if(kind == "c")
   {
      if(InList(g_lsSel, rep))
      {
         string keep[];
         for(int i = 0; i < ArraySize(g_lsSel); i++) if(g_lsSel[i] != rep) Push(keep, g_lsSel[i]);
         ArrayResize(g_lsSel, 0);
         for(int i = 0; i < ArraySize(keep); i++) Push(g_lsSel, keep[i]);
      }
      else Push(g_lsSel, rep);
      RefreshList();
   }
   else if(kind == "n")
   {
      ClearSel();
      SelectObj(rep, false);
      UpdateFB(true);
   }
   else if(kind == "t") ListApplyTo(one, 0);
   else if(kind == "a") ListApplyTo(one, 1);
   else if(kind == "x")
   {
      ListApplyTo(one, 3);
      RefreshList();
   }
}

//+------------------------------------------------------------------+
//| auto-convert native MT5 drawings (default names only)             |
//+------------------------------------------------------------------+
void AutoConvert()
{
   bool changed = false;
   for(int i = ObjectsTotal(0) - 1; i >= 0; i--)
   {
      string nm = ObjectName(0, i);
      if(IsDR(nm) || IsUI(nm)) continue;
      long ty = ObjectGetInteger(0, nm, OBJPROP_TYPE);
      string kind = "";
      if(ty == OBJ_TREND && StringFind(nm, "Trend Line ") == 0)            kind = "TL";
      else if(ty == OBJ_HLINE && StringFind(nm, "Horizontal Line ") == 0) kind = "HL";
      else if(ty == OBJ_RECTANGLE && StringFind(nm, "Rectangle ") == 0)    kind = "BX";
      else if(ty == OBJ_FIBO && StringFind(nm, "Fibo ") == 0)              kind = "FB";
      else if(ty == OBJ_TEXT && StringFind(nm, "Text ") == 0)              kind = "TX";
      if(kind == "") continue;

      string nn = NewName(kind);
      if(!ObjectSetString(0, nm, OBJPROP_NAME, nn)) continue;
      ObjectSetInteger(0, nn, OBJPROP_COLOR, g_color);
      ObjectSetInteger(0, nn, OBJPROP_WIDTH, g_width);
      ObjectSetInteger(0, nn, OBJPROP_STYLE, g_style);
      ObjectSetInteger(0, nn, OBJPROP_SELECTABLE, true);
      ObjectSetInteger(0, nn, OBJPROP_HIDDEN, false);
      if(ty == OBJ_FIBO) SetupFibo(nn, g_color);
      changed = true;
   }
   if(changed) { PushSnap(); RefreshList(); }
}

//+------------------------------------------------------------------+
//| drawing state machine                                             |
//+------------------------------------------------------------------+
void CancelDraw()
{
   if(g_clicks > 0 && g_active != "")
   {
      if(StringSubstr(g_active, StringLen(g_active) - 1) == "_") DeleteBase(g_active);
      else ObjectDelete(0, g_active);
   }
   g_clicks = 0;
   g_active = "";
}

void SetTool(ENUM_TOOL t)
{
   CancelDraw();
   g_tool = t;
   UpdateButtons();
}

void FinishDraw(string selName)
{
   g_clicks = 0;
   g_active = "";
   ClearSel();
   if(selName != "") ObjectSetInteger(0, selName, OBJPROP_SELECTED, true);
   PushSnap();
   if(!InpStayInTool) g_tool = T_NONE;
   UpdateButtons();
   UpdateFB(true);
}

void ConstrainShift(int x, int y, datetime &t, double &p)
{
   int x0, y0;
   if(!ChartTimePriceToXY(0, 0, g_t0, g_p0, x0, y0)) return;
   if(MathAbs(y - y0) <= MathAbs(x - x0)) p = g_p0;
   else t = g_t0;
}

void MoveSecond(int x, int y)
{
   if(g_clicks < 1 || g_active == "") return;
   datetime t;
   double p;
   if(!SnapPoint(x, y, CtrlDown(), t, p)) return;

   if(g_tool == T_PD)
   {
      datetime tl = (g_t0 < t ? g_t0 : t), tr = (g_t0 < t ? t : g_t0);
      PDSet(g_active, tl, tr, MathMax(g_p0, p), MathMin(g_p0, p));
   }
   else if(g_tool == T_CA)
   {
      if(g_clicks == 1)
      {
         g_t1 = t; g_p1 = p;
         g_tc = (datetime)((long)g_t0 + ((long)t - (long)g_t0) / 2);
         g_pc = (g_p0 + p) / 2.0;
      }
      else { g_tc = t; g_pc = p; }
      CAApply(g_active, false);
   }
   else if(g_tool == T_LONG || g_tool == T_SHORT)
   {
      bool lng = (g_tool == T_LONG);
      double minD = 2 * _Point;
      if(lng  && p > g_p0 - minD) p = g_p0 - minD;
      if(!lng && p < g_p0 + minD) p = g_p0 + minD;
      datetime t2 = g_t0 + (datetime)(InpLSBars * PeriodSeconds());
      double tp = g_p0 + (g_p0 - p) * InpDPP_RR;
      LSApply(g_active, g_t0, t2, g_p0, p, tp);
   }
   else if(g_tool == T_TL || g_tool == T_RAY)
   {
      if(ShiftDown()) ConstrainShift(x, y, t, p);
      ObjectMove(0, g_active + "ln", 1, t, p);
      RefreshTL(g_active);
   }
   else
   {
      if(ShiftDown()) ConstrainShift(x, y, t, p);
      ObjectMove(0, g_active, 1, t, p);
   }
   ChartRedraw(0);
}

void HandleDrawClick(int x, int y)
{
   datetime t;
   double p;
   if(!SnapPoint(x, y, CtrlDown(), t, p)) return;

   if(g_tool == T_HL)
   {
      string n = NewName("HL");
      ObjectCreate(0, n, OBJ_HLINE, 0, 0, p);
      StyleObj(n);
      FinishDraw(n);
      return;
   }
   if(g_tool == T_ARU || g_tool == T_ARD)
   {
      string n = NewName(g_tool == T_ARU ? "AU" : "AD");
      ObjectCreate(0, n, g_tool == T_ARU ? OBJ_ARROW_UP : OBJ_ARROW_DOWN, 0, t, p);
      StyleObj(n);
      FinishDraw(n);
      return;
   }
   if(g_tool == T_TXT)
   {
      string n = NewName("TX");
      ObjectCreate(0, n, OBJ_TEXT, 0, t, p);
      StyleObj(n);
      ObjectSetString(0, n, OBJPROP_TEXT, InpText);
      ObjectSetInteger(0, n, OBJPROP_FONTSIZE, 10);
      ObjectSetInteger(0, n, OBJPROP_ANCHOR, ANCHOR_LEFT_LOWER);
      FinishDraw(n);
      return;
   }

   if(g_tool == T_LONG || g_tool == T_SHORT)
   {
      if(g_clicks == 0)
      {
         string base = NewBase("LS");
         bool lng = (g_tool == T_LONG);
         double sl = (lng ? p - InpLSDefaultSL * _Point : p + InpLSDefaultSL * _Point);
         g_t0 = t; g_p0 = p;
         MakeLS(base, t, p, sl);
         g_active = base;
         g_clicks = 1;
      }
      else
      {
         MoveSecond(x, y);
         string base = g_active;
         FinishDraw(base + "tp");
      }
      return;
   }

   if(g_tool == T_PD)
   {
      if(g_clicks == 0)
      {
         string base = NewBase("PD");
         g_t0 = t; g_p0 = p;
         MakePD(base, t, p);
         g_active = base;
         g_clicks = 1;
      }
      else
      {
         MoveSecond(x, y);
         string base = g_active;
         FinishDraw(base + "pr");
      }
      return;
   }

   if(g_tool == T_CA)
   {
      if(g_clicks == 0)
      {
         string base = NewBase("GC");
         g_t0 = t; g_p0 = p;
         g_t1 = t; g_p1 = p;
         g_tc = t; g_pc = p;
         CAApply(base, true);
         g_active = base;
         g_clicks = 1;
      }
      else if(g_clicks == 1)
      {
         MoveSecond(x, y);      // fixes the end point
         g_clicks = 2;          // next the curvature
      }
      else
      {
         MoveSecond(x, y);
         string base = g_active;
         FinishDraw(base + "00");
      }
      return;
   }

   if(g_tool == T_TL || g_tool == T_RAY)
   {
      if(g_clicks == 0)
      {
         string base = NewBase("GT");
         g_t0 = t; g_p0 = p;
         MakeTL(base, g_tool == T_RAY, t, p);
         g_active = base;
         g_clicks = 1;
      }
      else
      {
         MoveSecond(x, y);
         string base = g_active;
         FinishDraw(base + "ln");
      }
      return;
   }

   // box, fib, fib extension
   if(g_clicks == 0)
   {
      string n = "";
      if(g_tool == T_BOX)
      {
         n = NewName("BX");
         ObjectCreate(0, n, OBJ_RECTANGLE, 0, t, p, t, p);
         StyleObj(n);
         ObjectSetInteger(0, n, OBJPROP_FILL, false);
      }
      else if(g_tool == T_FIB || g_tool == T_FIBX)
      {
         n = NewName(g_tool == T_FIB ? "FB" : "FX");
         ObjectCreate(0, n, OBJ_FIBO, 0, t, p, t, p);
         StyleObj(n);
         SetupFibo(n, g_color);
      }
      if(n == "") return;
      g_active = n;
      g_t0 = t;
      g_p0 = p;
      g_clicks = 1;
   }
   else
   {
      MoveSecond(x, y);
      FinishDraw(g_active);
   }
}

//+------------------------------------------------------------------+
//| UI clicks                                                         |
//+------------------------------------------------------------------+
void SyncDefaultsFromSelection()
{
   string sel[];
   if(GetSelected(sel) == 0) return;
   string ref = sel[0];
   if(InKind(ref, "_GT_")) ref = GroupBase(ref) + "ln";
   g_width = (int)ObjectGetInteger(0, ref, OBJPROP_WIDTH);
   if(g_width < 1) g_width = 1;
   g_style = (int)ObjectGetInteger(0, ref, OBJPROP_STYLE);
   if(g_style < 0 || g_style > 2) g_style = 0;
}

void HandleUI(string id)
{
   if(StringFind(id, "ls_") == 0) { HandleList(id); return; }
   bool fromFb = (StringFind(id, "fb_") == 0);
   if(fromFb) id = StringSubstr(id, 3);

   if(StringFind(id, "pal") == 0)
   {
      int k = (int)StringToInteger(StringSubstr(id, 3));
      PalHide();
      if(k >= 0 && k < 8) ApplyColor(PAL[k]);
      return;
   }

   if(id == "cur")      SetTool(T_NONE);
   else if(id == "tl")  SetTool(T_TL);
   else if(id == "hl")  SetTool(T_HL);
   else if(id == "ray") SetTool(T_RAY);
   else if(id == "box") SetTool(T_BOX);
   else if(id == "fib") SetTool(T_FIB);
   else if(id == "fbx") SetTool(T_FIBX);
   else if(id == "pd")  SetTool(T_PD);
   else if(id == "ca")  SetTool(T_CA);
   else if(id == "aru") SetTool(T_ARU);
   else if(id == "ard") SetTool(T_ARD);
   else if(id == "txt") SetTool(T_TXT);
   else if(id == "lng") SetTool(T_LONG);
   else if(id == "sht") SetTool(T_SHORT);
   else if(id == "undo") Undo();
   else if(id == "redo") Redo();
   else if(id == "mag")  { g_magnet = !g_magnet; UpdateButtons(); }
   else if(id == "col")
   {
      if(g_palOpen) PalHide();
      else if(fromFb) PalShow(g_fbX, MathMax(4, g_fbY - 32));
      else
      {
         int ci = ItemIndex("col");
         int px = g_tbX + PADT + GRIP + (ci % g_tbCols) * (CELL + CGAP);
         int py = g_tbY + PADT + (ci / g_tbCols) * (CELL + CGAP) - 34;
         PalShow(px, MathMax(4, py));
      }
   }
   else if(id == "wid")  { SyncDefaultsFromSelection(); ApplyWidth((g_width % 4) + 1); }
   else if(id == "sty")  { SyncDefaultsFromSelection(); ApplyStyle((g_style + 1) % 3); }
   else if(id == "fill") ApplyFill();
   else if(id == "lock") ApplyLock();
   else if(id == "unlk") UnlockAll();
   else if(id == "tf")   ApplyTF();
   else if(id == "del")  DeleteSelected();
   else if(id == "all")  ClearAll();
   else if(id == "exp")  ExportDrawings();
   else if(id == "imp")  ImportDrawings();
   else if(id == "lst")  ToggleList();
}

bool InRect(int x, int y, int rx, int ry, int rw, int rh)
{
   return (x >= rx && x <= rx + rw && y >= ry && y <= ry + rh);
}

bool OnUiArea(int x, int y)
{
   if(InRect(x, y, g_tbX, g_tbY, g_tbW, g_tbH)) return true;
   if(g_fbShown && InRect(x, y, g_fbX, g_fbY, FBW, FBH)) return true;
   if(g_palOpen && InRect(x, y, g_palX, g_palY, 8 * 24 + 4, 28)) return true;
   if(g_lsOpen && InRect(x, y, g_lsX, g_lsY, LSW, g_lsH)) return true;
   return false;
}

void ToolbarClick(int x, int y)
{
   ulong now = GetTickCount64();
   if(now - g_lastTbClick < 200) return;     // OBJECT_CLICK and CLICK can both fire
   g_lastTbClick = now;
   int i = ItemAt(x, y);
   if(i < 0) return;
   HandleUI(I_id[i]);
   ResetButtons();
   ChartRedraw(0);
}

//+------------------------------------------------------------------+
int DPP_Init()
{
   g_color = InpColor;
   g_lsAuto = InpAutoConvert;
   if(GlobalVariableCheck("DPN_tbx") && GlobalVariableCheck("DPN_tby"))
   {
      g_tbMoved = true;
      g_tbCX = (int)GlobalVariableGet("DPN_tbx");
      g_tbCY = (int)GlobalVariableGet("DPN_tby");
   }
   ChartSetInteger(0, CHART_EVENT_MOUSE_MOVE, true);
   SeedId();
   CreateUI();
   RefreshAllTL();

   ArrayResize(g_stack, 1);
   g_stack[0] = Snapshot();
   g_ui = 0;

   return INIT_SUCCEEDED;
}

void DPP_Deinit(const int reason)
{

   ObjectsDeleteAll(0, UI);   // drawings (DPN_) are kept on purpose
   ResourceFree("::dp_tb0");
   ResourceFree("::dp_tb1");
   ChartRedraw(0);
}

void DPP_Timer()
{
   if(g_clicks == 0) UpdateFB(false);
   if(g_lsAuto && g_clicks == 0) AutoConvert();
   if(g_lsOpen) ListTick();
}

void DPP_ChartEvent(const int id, const long &lparam, const double &dparam, const string &sparam)
{
   if(id == CHARTEVENT_OBJECT_CLICK)
   {
      if(IsUI(sparam))
      {
         if(sparam == UI + "fb_txt" || sparam == UI + "tip") return;
         if(sparam == UI + "tb") { ToolbarClick((int)lparam, (int)dparam); return; }
         HandleUI(StringSubstr(sparam, StringLen(UI)));
         ResetButtons();
         ChartRedraw(0);
      }
      else if(IsDR(sparam) && g_tool == T_NONE)
      {
         SelectObj(sparam, CtrlDown());
         UpdateFB(true);
      }
   }
   else if(id == CHARTEVENT_OBJECT_ENDEDIT)
   {
      if(sparam == UI + "fb_txt")
         ApplyText(ObjectGetString(0, UI + "fb_txt", OBJPROP_TEXT));
   }
   else if(id == CHARTEVENT_CLICK)
   {
      int x = (int)lparam, y = (int)dparam;
      if(InRect(x, y, g_tbX, g_tbY, g_tbW, g_tbH)) { ToolbarClick(x, y); return; }
      if(OnUiArea(x, y)) return;
      if(g_palOpen) PalHide();

      if(g_tool != T_NONE)
         HandleDrawClick(x, y);
      else
      {
         string hit = HitTest(x, y);
         if(hit == "") { if(!CtrlDown()) ClearSel(); }
         else SelectObj(hit, CtrlDown());
         UpdateFB(true);
         ChartRedraw(0);
      }
   }
   else if(id == CHARTEVENT_MOUSE_MOVE)
   {
      if(DragToolbar((int)lparam, (int)dparam, (int)StringToInteger(sparam))) return;
      HoverUpdate((int)lparam, (int)dparam);
      if(g_clicks >= 1) MoveSecond((int)lparam, (int)dparam);
   }
   else if(id == CHARTEVENT_CHART_CHANGE)
   {
      LayoutToolbar();
      if(g_lsOpen) LayoutList();
      RefreshAllTL();
      UpdateFB(true);
   }
   else if(id == CHARTEVENT_OBJECT_DRAG || id == CHARTEVENT_OBJECT_CHANGE)
   {
      if(IsDR(sparam))
      {
         if(IsGrp(sparam))
         {
            string gb = GroupBase(sparam);
            if(InKind(sparam, "_LS_"))      RefreshLS(gb);
            else if(InKind(sparam, "_PD_")) PDApply(gb, Suffix(sparam));
            else if(InKind(sparam, "_GT_")) RefreshTL(gb);
         }
         PushSnap();
         UpdateFB(true);
         ChartRedraw(0);
      }
   }
   else if(id == CHARTEVENT_KEYDOWN)
   {
      if(lparam == 27)                    { CancelDraw(); g_tool = T_NONE; PalHide(); UpdateButtons(); }
      else if(lparam == 46)               DeleteSelected();
      else if(lparam == 90 && CtrlDown()) Undo();
      else if(lparam == 89 && CtrlDown()) Redo();
   }
}
